@page "/storeowner/orders"
@using GearZone.Domain.Enums
@model GearZone.Web.Pages.StoreOwner.Orders.IndexModel
@{
    ViewData["Title"] = "Order Management";
    ViewData["PageHeader"] = "Order Management";
    ViewData["ActivePage"] = "Orders";
    ViewData["Breadcrumb"] = new string[] { "Orders" };
    Layout = "_StoreOwnerLayout";
}

<div class="flex flex-col gap-6">
    <!-- Stats Overview (Widgets) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total Orders -->
        <div class="bg-white p-4 rounded-xl shadow-card border border-slate-100 flex items-center gap-4">
            <div class="size-12 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center border border-blue-100/50">
                <span class="material-symbols-outlined">receipt_long</span>
            </div>
            <div>
                <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Total Orders</p>
                <h3 class="text-2xl font-bold text-slate-900">@Model.Stats.TotalOrders.ToString("N0")</h3>
            </div>
        </div>

        <!-- Paid Orders -->
        <div class="bg-white p-4 rounded-xl shadow-card border border-slate-100 flex items-center gap-4">
            <div class="size-12 rounded-lg bg-green-50 text-green-600 flex items-center justify-center border border-green-100/50">
                <span class="material-symbols-outlined">check_circle</span>
            </div>
            <div>
                <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Paid Orders</p>
                <h3 class="text-2xl font-bold text-slate-900">@Model.Stats.PaidOrders.ToString("N0")</h3>
            </div>
        </div>

        <!-- Unpaid Orders -->
        <div class="bg-white p-4 rounded-xl shadow-card border border-slate-100 flex items-center gap-4">
            <div class="size-12 rounded-lg bg-red-50 text-red-600 flex items-center justify-center border border-red-100/50">
                <span class="material-symbols-outlined">pending_actions</span>
            </div>
            <div>
                <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Unpaid Orders</p>
                <h3 class="text-2xl font-bold text-slate-900">@Model.Stats.UnpaidOrders.ToString("N0")</h3>
            </div>
        </div>

        <!-- Revenue -->
        <div class="bg-white p-4 rounded-xl shadow-card border border-slate-100 flex items-center gap-4">
            <div class="size-12 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center border border-indigo-100/50">
                <span class="material-symbols-outlined">payments</span>
            </div>
            <div>
                <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Total Revenue</p>
                <h3 class="text-2xl font-bold text-slate-900">@Model.Stats.TotalRevenue.ToString("N0") ₫</h3>
            </div>
        </div>
    </div>

    <!-- Filters Section (Form) -->
    <form method="get" id="filter-form" class="flex flex-col gap-4">
        <input type="hidden" name="PageNumber" id="page-number-input" value="@Model.PageNumber" />
        <input type="hidden" name="SortBy" id="sort-by-input" value="@Model.SortBy" />
        <input type="hidden" name="SortDirection" id="sort-dir-input" value="@Model.SortDirection" />
        <input type="hidden" name="Status" id="status-input" value="@Model.Status" />

        <!-- Status Tabs (As requested in the image) -->
        <div class="flex border-b border-slate-200 overflow-x-auto no-scrollbar">
            @{
                string TabClass(OrderStatus? status)
                {
                    bool isActive = Model.Status == status;
                    return isActive 
                        ? "px-6 py-3 text-sm font-bold border-b-2 border-primary text-primary whitespace-nowrap" 
                        : "px-6 py-3 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-700 hover:bg-slate-50 whitespace-nowrap transition-all";
                }
            }
            <button type="button" class="@TabClass(null)" onclick="setStatusAndSubmit('')">All</button>
            <button type="button" class="@TabClass(OrderStatus.Pending)" onclick="setStatusAndSubmit('Pending')">Pending</button>
            <button type="button" class="@TabClass(OrderStatus.Processing)" onclick="setStatusAndSubmit('Processing')">Processing</button>
            <button type="button" class="@TabClass(OrderStatus.Delivered)" onclick="setStatusAndSubmit('Delivered')">Delivered</button>
            <button type="button" class="@TabClass(OrderStatus.Completed)" onclick="setStatusAndSubmit('Completed')">Completed</button>
            <button type="button" class="@TabClass(OrderStatus.Cancelled)" onclick="setStatusAndSubmit('Cancelled')">Cancelled</button>
        </div>

        <!-- Filters & Actions Bar Card -->
        <div class="bg-white rounded-b-xl shadow-card border border-slate-100 overflow-hidden flex flex-col">
            <!-- Primary toolbar -->
            <div class="flex flex-col lg:flex-row gap-3 p-4 items-start lg:items-center">
                <!-- Search box -->
                <div class="relative flex-1 w-full">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400 pointer-events-none">
                        <span class="material-symbols-outlined text-[20px]">search</span>
                    </span>
                    <input asp-for="SearchTerm"
                           class="form-input w-full rounded-lg border-slate-200 bg-slate-50 pl-10 pr-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-primary focus:ring-primary focus:bg-white transition-colors"
                           placeholder="Search by order code, buyer name..."
                           type="text"
                           autocomplete="off" />
                </div>

                <!-- Toolbar actions -->
                <div class="flex items-center gap-2 shrink-0 w-full lg:w-auto">
                    <button type="submit"
                            class="flex-1 lg:flex-none flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark text-white px-4 py-2.5 rounded-lg text-sm font-medium shadow-sm shadow-blue-500/20 transition-all">
                        <span class="material-symbols-outlined text-[18px]">search</span>
                        <span>Search</span>
                    </button>

                    <button type="button" id="toggle-advanced-btn"
                            class="flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:border-slate-300 transition-colors shadow-sm text-sm whitespace-nowrap">
                        <span class="material-symbols-outlined text-[18px]">tune</span>
                        <span class="hidden sm:inline font-medium">Filters</span>
                        @{
                            var advancedActiveCount = 0;
                            if (!string.IsNullOrEmpty(Model.DateRangeShortcut)) advancedActiveCount++;
                            if (Model.MinSubtotal.HasValue || Model.MaxSubtotal.HasValue) advancedActiveCount++;
                        }
                        @if (advancedActiveCount > 0)
                        {
                            <span class="inline-flex items-center justify-center size-5 rounded-full bg-primary text-white text-[10px] font-bold">@advancedActiveCount</span>
                        }
                    </button>

                    <a asp-page="/StoreOwner/Orders/Index"
                       class="flex items-center justify-center p-2.5 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50 hover:text-slate-800 transition-colors bg-white shadow-sm"
                       title="Reset all filters">
                        <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                    </a>

                    <button type="button"
                            class="flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors shadow-sm text-sm whitespace-nowrap">
                        <span class="material-symbols-outlined text-[18px]">file_download</span>
                        <span class="hidden sm:inline font-medium">Export</span>
                    </button>
                </div>
            </div>

            <!-- Advanced Filters (Collapsible) -->
            @{
                var hasAdvanced = advancedActiveCount > 0;
            }
            <div id="advanced-filters"
                 class="@(hasAdvanced ? "" : "hidden") border-t border-slate-100 bg-slate-50/40 px-4 pt-4 pb-5 flex flex-col gap-5">

                <div class="flex flex-wrap lg:flex-nowrap items-start gap-4 lg:gap-6">
                    <!-- Amount Range -->
                    <div class="w-full lg:w-72 space-y-1 lg:shrink-0">
                        <label class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">payments</span> Subtotal Range (₫)
                        </label>
                        <div class="flex items-center gap-1.5">
                            <input asp-for="MinSubtotal" type="number" placeholder="Min" class="form-input min-w-0 w-full rounded-lg border-slate-200 bg-white py-2 text-sm px-2.5 shadow-sm h-[38px]" />
                            <span class="text-slate-300 flex-shrink-0 text-lg font-light">—</span>
                            <input asp-for="MaxSubtotal" type="number" placeholder="Max" class="form-input min-w-0 w-full rounded-lg border-slate-200 bg-white py-2 text-sm px-2.5 shadow-sm h-[38px]" />
                        </div>
                    </div>

                    <!-- Date Range -->
                    <div class="w-full lg:w-80 space-y-1 lg:shrink-0">
                        <label class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">calendar_today</span> Order Date
                        </label>
                        <div class="flex flex-col gap-2">
                            <select asp-for="DateRangeShortcut" id="dateRangeShortcut" class="form-select w-full rounded-lg border-slate-200 bg-white py-2 text-sm focus:ring-primary focus:border-primary h-[40px]" onchange="toggleCustomDateRange()">
                                <option value="">All Time</option>
                                <option value="today">Today</option>
                                <option value="week">This Week</option>
                                <option value="month">This Month</option>
                                <option value="custom">Custom Range</option>
                            </select>
                            <div id="customDateRangeContainer" class="relative @(Model.DateRangeShortcut == "custom" ? "" : "hidden")">
                                <span class="absolute inset-y-0 left-3 flex items-center text-slate-400">
                                    <span class="material-symbols-outlined text-[18px]">event</span>
                                </span>
                                <input type="text" asp-for="DateRange" id="dateRangePicker" class="form-input w-full pl-10 pr-4 py-2 border-slate-200 bg-white rounded-lg text-sm focus:ring-primary focus:border-primary cursor-pointer transition-all h-[40px]" placeholder="Select Range" />
                            </div>
                        </div>
                    </div>

                    <!-- Apply button -->
                    <div class="w-full lg:w-auto mt-2 lg:mt-[22px] lg:ms-auto">
                        <button type="submit"
                                class="w-full sm:w-auto h-[40px] flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-900 text-white px-6 rounded-lg text-sm font-semibold transition-colors shadow-sm">
                            <span class="material-symbols-outlined text-[17px]">check</span>
                            Apply Filters
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- Orders Table Card -->
    <div class="bg-white rounded-xl shadow-card border border-slate-100 overflow-hidden flex flex-col">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/50">
                        <th class="py-4 px-6 text-xs font-semibold uppercase tracking-wider text-slate-500">
                            <button type="button" class="sort-header inline-flex items-center gap-1 w-full hover:text-primary transition-colors group" data-col="orderCode">
                                Order Code
                                <span class="sort-icon material-symbols-outlined text-[16px] transition-all @(Model.SortBy == "orderCode" ? "text-primary" : "text-slate-300 group-hover:text-slate-400")">
                                    @(Model.SortBy == "orderCode" && Model.SortDirection == "asc" ? "arrow_upward" : Model.SortBy == "orderCode" && Model.SortDirection == "desc" ? "arrow_downward" : "unfold_more")
                                </span>
                            </button>
                        </th>
                        <th class="py-4 px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 hidden md:table-cell">Buyer</th>
                        <th class="py-4 px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 text-right">
                            <button type="button" class="sort-header inline-flex items-center justify-end gap-1 w-full hover:text-primary transition-colors group" data-col="subtotal">
                                Subtotal
                                <span class="sort-icon material-symbols-outlined text-[16px] transition-all @(Model.SortBy == "subtotal" ? "text-primary" : "text-slate-300 group-hover:text-slate-400")">
                                    @(Model.SortBy == "subtotal" && Model.SortDirection == "asc" ? "arrow_upward" : Model.SortBy == "subtotal" && Model.SortDirection == "desc" ? "arrow_downward" : "unfold_more")
                                </span>
                            </button>
                        </th>
                        <th class="py-4 px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 text-center">Status</th>
                        <th class="py-4 pr-6 pl-3 text-xs font-semibold uppercase tracking-wider text-slate-500 text-right">
                            <button type="button" class="sort-header inline-flex items-center justify-end gap-1 w-full hover:text-primary transition-colors group" data-col="createdAt">
                                Created
                                <span class="sort-icon material-symbols-outlined text-[16px] transition-all @(Model.SortBy == "createdAt" ? "text-primary" : "text-slate-300 group-hover:text-slate-400")">
                                    @(Model.SortBy == "createdAt" && Model.SortDirection == "asc" ? "arrow_upward" : Model.SortBy == "createdAt" && Model.SortDirection == "desc" ? "arrow_downward" : "unfold_more")
                                </span>
                            </button>
                        </th>
                        <th class="py-4 px-6 text-xs font-semibold uppercase tracking-wider text-slate-500 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Orders.Items.Any())
                    {
                        foreach (var order in Model.Orders.Items)
                        {
                            <tr class="hover:bg-slate-50 transition-all cursor-pointer group/row" onclick="if(!event.target.closest('a, button, form, input')) window.location.href='@Url.Page("/StoreOwner/Orders/Detail", new { subOrderId = order.SubOrderId })'">
                                <td class="py-4 px-6 align-middle font-mono text-sm font-semibold text-slate-900 group-hover/row:text-primary transition-colors">
                                    #@order.OrderCode
                                </td>
                                <td class="py-4 px-3 hidden md:table-cell align-middle whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(order.BuyerAvatarUrl))
                                        {
                                            <img src="@order.BuyerAvatarUrl" class="size-8 rounded-full object-cover" alt="" />
                                        }
                                        else
                                        {
                                            <div class="size-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 font-bold text-xs">
                                                @((!string.IsNullOrEmpty(order.BuyerDisplayName) ? order.BuyerDisplayName.Substring(0, 1).ToUpper() : "?"))
                                            </div>
                                        }
                                        <span class="text-sm text-slate-600">@order.BuyerDisplayName</span>
                                    </div>
                                </td>
                                <td class="py-4 px-3 text-right text-sm font-semibold text-slate-900 align-middle whitespace-nowrap">
                                    @order.Subtotal.ToString("N0") ₫
                                    <div class="text-[10px] text-slate-500 font-normal">@order.ItemCount item(s)</div>
                                </td>
                                <td class="py-4 px-3 text-center align-middle whitespace-nowrap">
                                    @{
                                        var statusClass = order.Status switch
                                        {
                                            OrderStatus.Pending => "bg-amber-50 text-amber-700 ring-amber-600/20",
                                            OrderStatus.Paid or OrderStatus.Processing => "bg-blue-50 text-blue-700 ring-blue-600/20",
                                            OrderStatus.Delivered or OrderStatus.Completed => "bg-green-50 text-green-700 ring-green-600/20",
                                            OrderStatus.Cancelled or OrderStatus.Rejected => "bg-red-50 text-red-700 ring-red-600/20",
                                            _ => "bg-slate-50 text-slate-700 ring-slate-600/20"
                                        };
                                        var dotClass = order.Status switch
                                        {
                                            OrderStatus.Pending => "bg-amber-500",
                                            OrderStatus.Paid or OrderStatus.Processing => "bg-blue-600",
                                            OrderStatus.Delivered or OrderStatus.Completed => "bg-green-600",
                                            OrderStatus.Cancelled or OrderStatus.Rejected => "bg-red-600",
                                            _ => "bg-slate-600"
                                        };
                                    }
                                    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1.5 text-xs font-semibold @statusClass ring-1 ring-inset">
                                        <span class="size-1.5 rounded-full @dotClass"></span> @order.Status.ToString()
                                    </span>
                                </td>
                                <td class="py-4 px-3 text-right align-middle whitespace-nowrap">
                                    <p class="text-sm text-slate-500">@order.CreatedAt.ToString("MMM dd, yyyy")</p>
                                </td>
                                <td class="py-4 px-6 text-right align-middle whitespace-nowrap">
                                    <div class="relative inline-block text-left dropdown-container">
                                        <button type="button" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-all dropdown-toggle" title="Actions" onclick="event.stopPropagation(); toggleDropdown(this);">
                                            <span class="material-symbols-outlined text-[20px]">more_vert</span>
                                        </button>
                                        <div class="hidden absolute right-0 mt-2 w-48 rounded-xl bg-white shadow-lg ring-1 ring-black ring-opacity-5 z-[50] dropdown-menu divide-y divide-slate-100 overflow-hidden" onclick="event.stopPropagation();">
                                            <div class="py-1">
                                                <a asp-page="/StoreOwner/Orders/Detail" asp-route-subOrderId="@order.SubOrderId" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors">
                                                    <span class="material-symbols-outlined text-[18px] text-slate-400">visibility</span>
                                                    View Details
                                                </a>
                                            </div>
                                            
                                            @if (order.Status == OrderStatus.Pending)
                                            {
                                                <div class="py-1">
                                                    <form method="post" asp-page-handler="Approve" asp-route-subOrderId="@order.SubOrderId">
                                                        <button type="button" onclick="handleConfirm(this, 'Approve Order', 'Are you sure you want to approve this order?', 'check_circle', 'bg-emerald-100 text-emerald-600', 'bg-emerald-600')" class="flex w-full items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors">
                                                        <span class="material-symbols-outlined text-[18px] text-emerald-600">verified</span>
                                                        Approve Order
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="Reject" asp-route-subOrderId="@order.SubOrderId">
                                                    <input type="hidden" name="reason" class="action-reason" value="" />
                                                    <button type="button" onclick="handleReject(this)" class="flex w-full items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-slate-50 transition-colors">
                                                        <span class="material-symbols-outlined text-[18px]">block</span>
                                                        Reject Order
                                                    </button>
                                                </form>
                                                </div>
                                            }
                                            
                                            @if (order.Status == OrderStatus.Paid || order.Status == OrderStatus.Approved)
                                            {
                                                <div class="py-1">
                                                <form method="post" asp-page-handler="MarkProcessing" asp-route-subOrderId="@order.SubOrderId">
                                                    <button type="button" onclick="handleConfirm(this, 'Start Processing', 'Move this order to processing?', 'local_shipping', 'bg-blue-100 text-blue-600', 'bg-primary')" class="flex w-full items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors">
                                                        <span class="material-symbols-outlined text-[18px] text-blue-600">package_2</span>
                                                        Start Processing
                                                    </button>
                                                </form>
                                                </div>
                                            }

                                            @if (order.Status == OrderStatus.Processing)
                                            {
                                                <div class="py-1">
                                                <form method="post" asp-page-handler="MarkDelivered" asp-route-subOrderId="@order.SubOrderId">
                                                    <button type="button" onclick="handleConfirm(this, 'Mark Delivered', 'Confirm delivery for this order?', 'inventory', 'bg-emerald-100 text-emerald-600', 'bg-emerald-600')" class="flex w-full items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors">
                                                        <span class="material-symbols-outlined text-[18px] text-emerald-600">local_shipping</span>
                                                        Mark Delivered
                                                    </button>
                                                </form>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-500">
                                <div class="flex flex-col items-center justify-center space-y-3">
                                    <div class="size-16 rounded-full bg-slate-50 flex items-center justify-center">
                                        <span class="material-symbols-outlined text-4xl text-slate-300">receipt_long</span>
                                    </div>
                                    <p class="text-base font-medium text-slate-900 mt-2">No orders found</p>
                                    <p class="text-sm">We couldn't find any orders matching your criteria.</p>
                                    <button type="button" class="mt-2 text-sm text-primary font-medium hover:underline" onclick="window.location.href='/storeowner/orders'">Clear all filters</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="border-t border-slate-100 px-6 py-4 bg-slate-50/30 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="text-sm text-slate-500">
                Showing <span class="font-medium text-slate-900">@((Model.Orders.PageNumber - 1) * Model.Orders.PageSize + (Model.Orders.Items.Any() ? 1 : 0))</span> to
                <span class="font-medium text-slate-900">
                    @(System.Math.Min(Model.Orders.PageNumber * Model.Orders.PageSize, Model.Orders.TotalCount))
                </span> of
                <span class="font-medium text-slate-900">@Model.Orders.TotalCount.ToString("N0")</span> orders
            </div>

            @if (Model.Orders.TotalPages > 1)
            {
                <nav aria-label="Pagination" class="flex items-center gap-1">
                    @if (Model.Orders.PageNumber > 1)
                    {
                        <button type="button" onclick="gotoPage(@(Model.Orders.PageNumber - 1))" class="p-2 rounded-lg border border-slate-200 text-slate-400 hover:bg-white hover:text-primary hover:border-primary transition-all shadow-sm">
                            <span class="material-symbols-outlined text-lg leading-none">chevron_left</span>
                        </button>
                    }
                    else
                    {
                        <div class="p-2 rounded-lg border border-slate-100 text-slate-300 bg-slate-50 cursor-not-allowed">
                            <span class="material-symbols-outlined text-lg leading-none">chevron_left</span>
                        </div>
                    }

                    <div class="flex items-center gap-1 px-1">
                        @{
                            int startPage = System.Math.Max(1, Model.Orders.PageNumber - 2);
                            int endPage = System.Math.Min(Model.Orders.TotalPages, startPage + 4);
                            if (endPage - startPage < 4 && startPage > 1)
                            {
                                startPage = System.Math.Max(1, endPage - 4);
                            }
                        }
                        
                        @if (startPage > 1)
                        {
                            <button type="button" onclick="gotoPage(1)" class="min-w-[36px] h-9 flex items-center justify-center rounded-lg text-sm font-medium transition-all border border-transparent text-slate-600 hover:border-slate-200 hover:bg-white hover:text-primary">1</button>
                            @if (startPage > 2)
                            {
                                <span class="text-slate-400 px-1">...</span>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <button type="button" @(i != Model.Orders.PageNumber ? $"onclick=gotoPage({i})" : "") class="min-w-[36px] h-9 flex items-center justify-center rounded-lg text-sm font-medium transition-all @(i == Model.Orders.PageNumber ? "bg-primary text-white shadow-sm shadow-blue-500/20" : "border border-transparent text-slate-600 hover:border-slate-200 hover:bg-white hover:text-primary")">
                                @i
                            </button>
                        }

                        @if (endPage < Model.Orders.TotalPages)
                        {
                            @if (endPage < Model.Orders.TotalPages - 1)
                            {
                                <span class="text-slate-400 px-1">...</span>
                            }
                            <button type="button" onclick="gotoPage(@Model.Orders.TotalPages)" class="min-w-[36px] h-9 flex items-center justify-center rounded-lg text-sm font-medium transition-all border border-transparent text-slate-600 hover:border-slate-200 hover:bg-white hover:text-primary">@Model.Orders.TotalPages</button>
                        }
                    </div>

                    @if (Model.Orders.PageNumber < Model.Orders.TotalPages)
                    {
                        <button type="button" onclick="gotoPage(@(Model.Orders.PageNumber + 1))" class="p-2 rounded-lg border border-slate-200 text-slate-400 hover:bg-white hover:text-primary hover:border-primary transition-all shadow-sm">
                            <span class="material-symbols-outlined text-lg leading-none">chevron_right</span>
                        </button>
                    }
                    else
                    {
                        <div class="p-2 rounded-lg border border-slate-100 text-slate-300 bg-slate-50 cursor-not-allowed">
                            <span class="material-symbols-outlined text-lg leading-none">chevron_right</span>
                        </div>
                    }
                </nav>
            }
        </div>
    </div>
</div>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        function handleConfirm(btn, title, text, icon, iconClass, btnClass) {
            const form = btn.closest('form');
            window.showConfirmModal({
                title: title,
                message: text,
                confirmText: "Confirm",
                confirmClass: btnClass,
                icon: icon,
                iconClass: iconClass,
                onConfirm: () => form.submit()
            });
        }

        function handleReject(btn) {
            const form = btn.closest('form');
            window.showReasonModal({
                title: "Reject Order",
                message: "Please provide a reason for rejecting this order.",
                confirmText: "Reject",
                confirmClass: "bg-red-600",
                icon: "block",
                iconClass: "bg-red-100 text-red-600",
                onConfirm: (reason) => {
                    const reasonInput = form.querySelector('.action-reason');
                    if (reasonInput) reasonInput.value = reason;
                    form.submit();
                }
            });
        }

        function gotoPage(page) {
            const pageInput = document.getElementById('page-number-input');
            const filterForm = document.getElementById('filter-form');
            if (pageInput && filterForm) {
                pageInput.value = page;
                filterForm.submit();
            }
        }

        function setStatusAndSubmit(status) {
            const statusInput = document.getElementById('status-input');
            const filterForm = document.getElementById('filter-form');
            const pageInput = document.getElementById('page-number-input');
            if (statusInput && filterForm) {
                statusInput.value = status;
                if (pageInput) pageInput.value = 1;
                filterForm.submit();
            }
        }

        function toggleCustomDateRange() {
            const select = document.getElementById('dateRangeShortcut');
            const container = document.getElementById('customDateRangeContainer');
            if (select.value === 'custom') {
                container.classList.remove('hidden');
            } else {
                container.classList.add('hidden');
                const picker = document.getElementById('dateRangePicker');
                if (picker) picker.value = '';
            }
        }

        function toggleDropdown(btn) {
            // Close all other dropdowns
            document.querySelectorAll('.dropdown-menu').forEach(menu => {
                if (menu !== btn.nextElementSibling) {
                    menu.classList.add('hidden');
                    menu.parentElement.querySelector('.dropdown-toggle').classList.remove('bg-slate-100', 'text-slate-600');
                }
            });

            const menu = btn.nextElementSibling;
            const isHidden = menu.classList.contains('hidden');
            
            if (isHidden) {
                menu.classList.remove('hidden');
                btn.classList.add('bg-slate-100', 'text-slate-600');
            } else {
                menu.classList.add('hidden');
                btn.classList.remove('bg-slate-100', 'text-slate-600');
            }
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.dropdown-container')) {
                document.querySelectorAll('.dropdown-menu').forEach(menu => {
                    menu.classList.add('hidden');
                    menu.parentElement.querySelector('.dropdown-toggle').classList.remove('bg-slate-100', 'text-slate-600');
                });
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            flatpickr("#dateRangePicker", {
                mode: "range",
                dateFormat: "Y-m-d",
                allowInput: true
            });
            const toggleAdvancedBtn = document.getElementById('toggle-advanced-btn');
            const advancedFilters = document.getElementById('advanced-filters');

            if (advancedFilters && !advancedFilters.classList.contains('hidden')) {
                toggleAdvancedBtn?.classList.add('bg-slate-50', 'border-slate-300', 'text-slate-900');
            }

            if (toggleAdvancedBtn) {
                toggleAdvancedBtn.addEventListener('click', function() {
                    advancedFilters.classList.toggle('hidden');
                    if (advancedFilters.classList.contains('hidden')) {
                        this.classList.remove('bg-slate-50', 'text-slate-900', 'border-slate-300');
                    } else {
                        this.classList.add('bg-slate-50', 'text-slate-900', 'border-slate-300');
                    }
                });
            }

            const sortByInput = document.getElementById('sort-by-input');
            const sortDirInput = document.getElementById('sort-dir-input');
            const filterForm = document.getElementById('filter-form');

            document.querySelectorAll('.sort-header').forEach(btn => {
                btn.addEventListener('click', function () {
                    const col = this.dataset.col;
                    const currentCol = sortByInput.value;
                    const currentDir = sortDirInput.value;

                    let nextDir = '';
                    if (currentCol !== col) {
                        nextDir = 'desc';
                    } else if (currentDir === 'desc') {
                        nextDir = 'asc';
                    } else if (currentDir === 'asc') {
                        nextDir = '';
                    } else {
                        nextDir = 'desc';
                    }

                    if (nextDir === '') {
                        sortByInput.value = '';
                        sortDirInput.value = '';
                    } else {
                        sortByInput.value = col;
                        sortDirInput.value = nextDir;
                    }

                    const pageInput = document.getElementById('page-number-input');
                    if (pageInput) pageInput.value = '1';

                    filterForm.submit();
                });
            });
        });
    </script>
}

