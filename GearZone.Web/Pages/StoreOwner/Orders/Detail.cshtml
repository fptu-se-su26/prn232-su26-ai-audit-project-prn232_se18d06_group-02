@page "/storeowner/orders/{subOrderId:guid}"
@using GearZone.Domain.Enums
@using System.Collections.Generic
@model GearZone.Web.Pages.StoreOwner.Orders.DetailModel
@{
    ViewData["Title"] = $"Order #{Model.OrderDetail.OrderCode}";
    ViewData["PageHeader"] = $"Order #{Model.OrderDetail.OrderCode}";
    ViewData["ActivePage"] = "Orders";
    ViewData["Breadcrumb"] = new[] { "Orders", $"#{Model.OrderDetail.OrderCode}" };
    Layout = "_StoreOwnerLayout";

    var subOrder = Model.OrderDetail;
    var paidLike = subOrder.Status == OrderStatus.Paid || subOrder.Status == OrderStatus.Processing || subOrder.Status == OrderStatus.Delivered || subOrder.Status == OrderStatus.Completed;
    var deliveredLike = subOrder.Status == OrderStatus.Delivered || subOrder.Status == OrderStatus.Completed;
    var warningLike = subOrder.Status == OrderStatus.Cancelled || subOrder.Status == OrderStatus.Rejected || subOrder.Status == OrderStatus.Refunded;
}

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">@TempData["ErrorMessage"]</div>
}

<div class="mb-8 flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
    <div class="flex flex-wrap items-center gap-3">
        @if (paidLike)
        {
            <span class="flex items-center gap-1.5 rounded-full border border-emerald-200/50 bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-700 shadow-sm"><span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span> PAID</span>
        }
        else
        {
            <span class="flex items-center gap-1.5 rounded-full border border-amber-200/50 bg-amber-100 px-3 py-1 text-xs font-bold text-amber-700 shadow-sm"><span class="h-2 w-2 rounded-full bg-amber-500"></span> UNPAID</span>
        }

        @if (deliveredLike)
        {
            <span class="flex items-center gap-1.5 rounded-full border border-blue-200/50 bg-blue-100 px-3 py-1 text-xs font-bold text-blue-700 shadow-sm"><span class="h-2 w-2 rounded-full bg-blue-500"></span> FULLY DELIVERED</span>
        }
        else if (warningLike)
        {
            <span class="flex items-center gap-1.5 rounded-full border border-red-200/50 bg-red-100 px-3 py-1 text-xs font-bold text-red-700 shadow-sm"><span class="h-2 w-2 rounded-full bg-red-500"></span> ATTENTION REQUIRED</span>
        }
        else
        {
            <span class="flex items-center gap-1.5 rounded-full border border-slate-200/50 bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700 shadow-sm"><span class="h-2 w-2 rounded-full bg-slate-400"></span> PROCESSING</span>
        }
    </div>

    <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition-all hover:border-slate-300 hover:bg-slate-50">
            <span class="material-symbols-outlined text-lg">print</span>
            <span>Print Invoice</span>
        </button>
        <button type="button" class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition-all hover:border-slate-300 hover:bg-slate-50">
            <span class="material-symbols-outlined text-lg">download</span>
            <span>Export PDF</span>
        </button>

        @if (subOrder.Status == OrderStatus.Pending)
        {
            <form method="post" asp-page-handler="Approve" asp-route-subOrderId="@subOrder.SubOrderId" class="inline">
                <button type="button" onclick="handleConfirm(this, 'Approve Order', 'Approve this order?', 'check_circle', 'bg-emerald-100 text-emerald-600', 'bg-emerald-600')" class="flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-dark">
                    <span class="material-symbols-outlined text-lg">check_circle</span><span>Approve</span>
                </button>
            </form>
            <form method="post" asp-page-handler="Reject" asp-route-subOrderId="@subOrder.SubOrderId" class="inline">
                <input type="hidden" name="reason" class="action-reason" value="" />
                <button type="button" onclick="handleReject(this)" class="flex items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-bold text-red-700 transition-all hover:bg-red-100">
                    <span class="material-symbols-outlined text-lg">cancel</span><span>Reject</span>
                </button>
            </form>
        }
        else if (subOrder.Status == OrderStatus.Approved || subOrder.Status == OrderStatus.Paid)
        {
            <form method="post" asp-page-handler="MarkProcessing" asp-route-subOrderId="@subOrder.SubOrderId" class="inline">
                <button type="button" onclick="handleConfirm(this, 'Start Processing', 'Move this order to processing?', 'local_shipping', 'bg-blue-100 text-blue-600', 'bg-primary')" class="flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-dark">
                    <span class="material-symbols-outlined text-lg">local_shipping</span><span>Update Status</span>
                </button>
            </form>
        }
        else if (subOrder.Status == OrderStatus.Processing)
        {
            <form method="post" asp-page-handler="MarkDelivered" asp-route-subOrderId="@subOrder.SubOrderId" class="inline">
                <button type="button" onclick="handleConfirm(this, 'Mark Delivered', 'Confirm delivery for this order?', 'inventory', 'bg-emerald-100 text-emerald-600', 'bg-emerald-600')" class="flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-dark">
                    <span class="material-symbols-outlined text-lg">inventory</span><span>Update Status</span>
                </button>
            </form>
        }
    </div>
</div>

<div class="mx-auto max-w-7xl custom-scrollbar">
    <div class="grid grid-cols-1 gap-8 xl:grid-cols-3">
        <div class="space-y-8 xl:col-span-2">
            <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
                <div class="flex items-center justify-between border-b border-slate-50 p-6">
                    <div class="flex items-center gap-2"><span class="material-symbols-outlined text-primary">info</span><h3 class="font-bold text-slate-800">General Information</h3></div>
                    <span class="rounded-lg bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">Internal Reference</span>
                </div>
                <div class="grid grid-cols-1 gap-8 p-6 md:grid-cols-2 lg:grid-cols-3">
                    <div class="flex flex-col gap-1">
                        <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Customer</p>
                        <p class="text-sm font-bold text-slate-900">@subOrder.BuyerDisplayName</p>
                        <p class="mt-1 flex items-center gap-1.5 text-xs text-slate-500"><span class="material-symbols-outlined text-xs">mail</span>@(string.IsNullOrWhiteSpace(subOrder.BuyerEmail) ? "No email" : subOrder.BuyerEmail)</p>
                    </div>
                    <div class="flex flex-col gap-1">
                        <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Date Placed</p>
                        <p class="text-sm font-bold text-slate-900">@subOrder.CreatedAt.ToLocalTime().ToString("MMMM dd, yyyy")</p>
                        <p class="mt-1 flex items-center gap-1.5 text-xs text-slate-500"><span class="material-symbols-outlined text-xs">schedule</span>@subOrder.CreatedAt.ToLocalTime().ToString("hh:mm tt")</p>
                    </div>
                    <div class="flex flex-col gap-1">
                        <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Source Store(s)</p>
                        <p class="text-sm font-bold text-primary">1 Store(s)</p>
                        <div class="mt-1.5 flex -space-x-2 overflow-hidden"><div class="flex size-6 items-center justify-center rounded-full border-2 border-white bg-slate-200 text-[8px] font-bold text-slate-600" title="@subOrder.StoreName">@subOrder.StoreName.Substring(0,1)</div></div>
                    </div>
                </div>
            </div>

            <div class="mb-6 overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-50 bg-slate-50/30 p-6">
                    <div class="flex items-center gap-3">
                        <div class="flex size-10 items-center justify-center rounded-xl border border-slate-100 bg-white text-primary shadow-sm"><span class="material-symbols-outlined">storefront</span></div>
                        <div><h3 class="font-bold text-slate-800">@subOrder.StoreName</h3><p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Store Shipment</p></div>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="hidden text-right sm:block"><p class="mb-1 text-[10px] font-bold uppercase tracking-widest leading-none text-slate-400">Sub-Order ID</p><p class="text-xs font-mono font-bold text-slate-600">#@subOrder.SubOrderId.ToString().Substring(0,8).ToUpper()</p></div>
                        <span class="rounded-xl px-3 py-1.5 text-xs font-black tracking-wider shadow-sm @(subOrder.Status == OrderStatus.Delivered ? "bg-green-100 text-green-700" : subOrder.Status == OrderStatus.Cancelled ? "bg-red-100 text-red-700" : "bg-blue-100 text-blue-700")">@subOrder.Status.ToString().ToUpper()</span>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-left">
                        <thead>
                            <tr class="border-b border-slate-50 bg-slate-50/20">
                                <th class="px-6 py-4 text-[11px] font-black uppercase tracking-widest text-slate-400">Product Details</th>
                                <th class="px-6 py-4 text-right text-[11px] font-black uppercase tracking-widest text-slate-400">Unit Price</th>
                                <th class="px-6 py-4 text-center text-[11px] font-black uppercase tracking-widest text-slate-400">Qty</th>
                                <th class="px-6 py-4 text-right text-[11px] font-black uppercase tracking-widest text-slate-400">Amount</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            @foreach (var item in subOrder.Items)
                            {
                                <tr class="transition-colors hover:bg-slate-50/50">
                                    <td class="px-6 py-5">
                                        <div class="flex items-center gap-4">
                                            <div class="relative flex-shrink-0">
                                                <div class="flex size-14 items-center justify-center rounded-xl border border-slate-100 bg-slate-50 shadow-sm"><span class="material-symbols-outlined text-slate-200">inventory_2</span></div>
                                            </div>
                                            <div>
                                                <p class="mb-1 leading-tight text-sm font-bold text-slate-900">@item.ProductName</p>
                                                <div class="inline-flex rounded-lg bg-slate-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-500">@item.VariantName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5 text-right text-sm font-medium text-slate-600">@item.UnitPrice.ToString("N0") d</td>
                                    <td class="bg-slate-50/30 px-6 py-5 text-center text-sm font-black text-slate-900">@item.Quantity</td>
                                    <td class="px-6 py-5 text-right text-sm font-black text-slate-900">@item.LineTotal.ToString("N0") d</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="border-t border-slate-50 bg-slate-50/20 px-6 py-8">
                    <div class="mb-4 flex items-center gap-2"><span class="material-symbols-outlined text-xs text-slate-400">payments</span><span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Internal Transaction Analytics</span></div>
                    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
                        <div class="flex flex-col gap-1 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm"><p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Subtotal (Gross)</p><p class="text-xl font-black text-slate-900">@subOrder.Subtotal.ToString("N0") <span class="text-xs font-medium italic">d</span></p></div>
                        <div class="flex flex-col gap-1 rounded-2xl border border-amber-100/50 bg-amber-50/30 p-5 shadow-sm"><p class="text-[10px] font-bold uppercase tracking-wider text-amber-600">Platform Fee (@subOrder.CommissionRateSnapshot.ToString("N0")%)</p><p class="text-xl font-black text-amber-700">- @subOrder.CommissionAmount.ToString("N0") <span class="text-xs font-medium italic">d</span></p></div>
                        <div class="flex flex-col gap-1 rounded-2xl border border-emerald-100/50 bg-emerald-50/30 p-5 shadow-sm"><p class="text-[10px] font-bold uppercase tracking-wider text-emerald-600">Store Net Payout</p><p class="text-xl font-black text-emerald-700">@subOrder.NetAmount.ToString("N0") <span class="text-xs font-medium italic">d</span></p></div>
                    </div>
                </div>
            </div>

            <div class="group relative overflow-hidden rounded-3xl bg-slate-900 shadow-2xl">
                <div class="absolute right-0 top-0 -mr-32 h-full w-64 bg-primary/10 blur-3xl transition-all group-hover:bg-primary/20"></div>
                <div class="relative flex flex-col items-center justify-between gap-8 p-8 md:flex-row">
                    <div class="flex items-center gap-4">
                        <div class="flex size-14 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-white shadow-inner"><span class="material-symbols-outlined text-2xl">receipt_long</span></div>
                        <div><p class="mb-1 text-[10px] font-black uppercase tracking-widest text-slate-500">Total Payable Amount</p><h3 class="text-lg font-black tracking-tight text-white">Consolidated Order Invoice</h3></div>
                    </div>
                    <div class="flex min-w-[240px] flex-col items-end gap-3">
                        <div class="flex w-full items-center justify-between border-b border-white/5 pb-2 text-xs font-bold uppercase tracking-widest text-slate-400"><span>Sum of Items</span><span class="text-slate-300">@subOrder.Subtotal.ToString("N0") d</span></div>
                        <div class="flex w-full items-center justify-between border-b border-white/5 pb-2 text-xs font-bold uppercase tracking-widest text-slate-400"><span>Logistics Fee</span><span class="text-slate-300">+ @subOrder.ShippingFee.ToString("N0") d</span></div>
                        <div class="mt-2 flex w-full items-center justify-between"><span class="text-base font-black uppercase tracking-tighter text-white">Grand Total</span><span class="text-3xl font-black tracking-tighter text-white drop-shadow-lg">@subOrder.GrandTotal.ToString("N0") <span class="text-sm font-medium">d</span></span></div>
                    </div>
                </div>
            </div>

            <div class="overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm">
                <div class="flex items-center justify-between border-b border-slate-50 p-8">
                    <div class="flex items-center gap-3"><div class="flex size-10 items-center justify-center rounded-xl bg-slate-900 text-white shadow-lg"><span class="material-symbols-outlined text-lg">history</span></div><h3 class="text-lg font-bold text-slate-900">Order Tracking Activity</h3></div>
                    <span class="rounded-lg bg-slate-100 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-slate-500">Real-time History</span>
                </div>
                <div class="p-8">
                    @if (subOrder.StatusHistory.Any())
                    {
                        var statusIcons = new Dictionary<OrderStatus, string>
                        {
                            { OrderStatus.Pending, "pending" },
                            { OrderStatus.AwaitingPayment, "payments" },
                            { OrderStatus.Approved, "verified" },
                            { OrderStatus.Rejected, "block" },
                            { OrderStatus.Paid, "paid" },
                            { OrderStatus.Processing, "package_2" },
                            { OrderStatus.Delivered, "local_shipping" },
                            { OrderStatus.Cancelled, "do_not_disturb_on" },
                            { OrderStatus.Completed, "task_alt" },
                            { OrderStatus.Refunded, "keyboard_return" }
                        };

                        <div class="relative space-y-10 before:absolute before:inset-0 before:ml-[19px] before:h-full before:w-1 before:bg-gradient-to-b before:from-primary before:via-blue-300 before:to-transparent">
                            @foreach (var history in subOrder.StatusHistory.OrderByDescending(h => h.ChangedAt))
                            {
                                var icon = statusIcons.ContainsKey(history.NewStatus) ? statusIcons[history.NewStatus] : "check_circle";
                                <div class="group relative flex items-start gap-8">
                                    <div class="z-10 rounded-full border-4 border-slate-50 bg-white p-1 transition-all group-first:border-primary/20"><div class="flex size-7 items-center justify-center rounded-full border-2 border-primary bg-white shadow-sm"><span class="material-symbols-outlined text-[14px] font-black text-primary">@icon</span></div></div>
                                    <div class="-mt-1 flex-1 rounded-2xl border border-slate-100 bg-slate-50/50 p-5 transition-all hover:border-primary/20 hover:bg-white hover:shadow-md">
                                        <div class="mb-2 flex items-center justify-between"><h4 class="text-sm font-black uppercase tracking-wider text-slate-900">@history.NewStatus.ToString()</h4><span class="flex items-center gap-1.5 text-[10px] font-bold text-slate-400"><span class="material-symbols-outlined text-[10px]">calendar_month</span>@history.ChangedAt.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")</span></div>
                                        @if (!string.IsNullOrEmpty(history.Note))
                                        {
                                            <div class="relative"><span class="absolute left-0 top-0 text-2xl leading-none text-slate-200">"</span><p class="px-4 text-sm italic text-slate-500">@history.Note</p></div>
                                        }
                                        <div class="mt-3 flex items-center gap-2 border-t border-slate-100/50 pt-3"><span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Modified From</span><span class="rounded bg-slate-100 px-2 py-0.5 text-[10px] font-black text-slate-500">@(history.OldStatus?.ToString() ?? "-" )</span></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center gap-3 rounded-3xl border-2 border-dashed border-slate-100 py-12 text-slate-400"><span class="material-symbols-outlined text-4xl opacity-20">history_toggle_off</span><p class="text-sm font-bold uppercase tracking-widest opacity-40">No activity recorded yet</p></div>
                    }
                </div>
            </div>
        </div>

        <div class="space-y-8">
            <div class="overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm">
                <div class="flex items-center gap-3 border-b border-slate-50 p-6"><div class="flex size-8 items-center justify-center rounded-lg bg-blue-50 text-primary"><span class="material-symbols-outlined text-lg">local_shipping</span></div><h3 class="font-bold text-slate-800">Logistic Details</h3></div>
                <div class="space-y-8 p-6">
                    <div>
                        <p class="mb-3 text-[10px] font-black uppercase tracking-widest text-slate-400">Recipient</p>
                        <div class="flex items-center gap-3">
                            <div class="flex size-10 items-center justify-center rounded-full bg-slate-100 font-bold text-slate-500">@subOrder.ReceiverName.Substring(0,1)</div>
                            <div><p class="leading-none text-sm font-black text-slate-900">@subOrder.ReceiverName</p><p class="mt-1 text-xs text-slate-500">@subOrder.ReceiverPhone</p></div>
                        </div>
                    </div>
                    <div>
                        <p class="mb-3 text-[10px] font-black uppercase tracking-widest text-slate-400">Destination Address</p>
                        <div class="rounded-2xl border border-slate-100 bg-slate-50 p-5 text-sm font-medium leading-relaxed text-slate-700 shadow-inner">@Html.Raw(subOrder.ShippingAddress.Replace(",", ",<br/>"))</div>
                    </div>
                    <div class="space-y-4 pt-2">
                        <div class="flex items-center justify-between"><p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Shipping Agent</p><span class="text-xs font-bold text-slate-900">@(subOrder.ShippingProvider ?? "PENDING ASSIGNMENT")</span></div>
                        <div>
                            <p class="mb-2 text-right text-[10px] font-black uppercase tracking-widest text-slate-400">Waybill / Tracking</p>
                            @if (!string.IsNullOrEmpty(subOrder.TrackingNumber))
                            {
                                <div class="flex items-center justify-end gap-2"><code class="rounded-lg border border-primary/10 bg-primary/5 px-3 py-1.5 font-mono text-[11px] font-bold text-primary">@subOrder.TrackingNumber</code><button type="button" class="flex size-8 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-400 shadow-sm transition-all hover:border-primary hover:text-primary" onclick="navigator.clipboard.writeText('@subOrder.TrackingNumber')"><span class="material-symbols-outlined text-[16px]">content_copy</span></button></div>
                            }
                            else
                            {
                                <p class="text-right text-xs italic text-slate-400">No tracking info yet.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm">
                <div class="flex items-center gap-3 border-b border-slate-50 p-6"><div class="flex size-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600"><span class="material-symbols-outlined text-lg">account_balance_wallet</span></div><h3 class="font-bold text-slate-800">Financial Clearance</h3></div>
                <div class="p-6">
                    <div class="space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-50 py-3"><span class="text-xs font-bold uppercase tracking-widest text-slate-400">Gateway</span><span class="flex items-center gap-1.5 text-sm font-black text-slate-900"><span class="material-symbols-outlined text-sm text-primary">contactless</span>COD</span></div>
                        <div class="flex items-center justify-between border-b border-slate-50 py-3"><span class="text-xs font-bold uppercase tracking-widest text-slate-400">Aggregator</span><span class="text-sm font-black text-slate-900">COD</span></div>
                        <div class="flex items-center justify-between border-b border-slate-50 py-3"><span class="text-xs font-bold uppercase tracking-widest text-slate-400">Status</span><span class="rounded-lg px-2.5 py-1 text-[10px] font-black uppercase tracking-wider @(paidLike ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700")">@(paidLike ? "PAID" : "PENDING")</span></div>
                        <div class="flex items-center justify-between border-b border-slate-50 py-3"><span class="text-xs font-bold uppercase tracking-widest text-slate-400">Voucher Ref</span><span class="rounded bg-slate-50 px-2 py-1 font-mono text-[11px] font-bold text-slate-500">PLATFORM_CREDIT</span></div>
                    </div>
                </div>
            </div>

            <div class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-950 p-8 text-white shadow-2xl">
                <div class="absolute -right-10 -top-10 size-40 rounded-full bg-blue-500/10 blur-3xl transition-all group-hover:bg-blue-500/20"></div>
                <div class="absolute -bottom-10 -left-10 size-32 rounded-full bg-indigo-500/10 blur-2xl"></div>
                <div class="relative">
                    <div class="mb-6 flex size-12 items-center justify-center rounded-2xl border border-white/20 bg-white/10 shadow-lg backdrop-blur-xl"><span class="material-symbols-outlined text-2xl">support_agent</span></div>
                    <h4 class="mb-3 text-xl font-black tracking-tight">Need Assistance?</h4>
                    <p class="mb-8 text-sm font-medium leading-relaxed text-slate-300">Our senior administrators are ready to resolve any seller-customer disputes 24/7.</p>
                    <div class="flex flex-col gap-3">
                        <button type="button" class="flex w-full items-center justify-center gap-2 rounded-2xl bg-white py-3.5 text-sm font-black text-slate-900 shadow-xl shadow-white/5 transition-all hover:scale-[1.02] active:scale-[0.98]"><span class="material-symbols-outlined text-[18px]">emergency</span>Raise Multi-party Ticket</button>
                        <button type="button" class="flex w-full items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 py-3.5 text-sm font-bold text-white transition-all hover:bg-white/10">Learn Dispute Policy<span class="material-symbols-outlined text-[16px]">open_in_new</span></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function handleConfirm(btn, title, text, icon, iconClass, btnClass) {
            const form = btn.closest('form');
            window.showConfirmModal({
                title: title,
                message: text,
                confirmText: "Confirm",
                confirmClass: btnClass,
                icon: icon,
                iconClass: iconClass,
                onConfirm: () => form.submit()
            });
        }

        function handleReject(btn) {
            const form = btn.closest('form');
            window.showReasonModal({
                title: "Reject Order",
                message: "Please provide a reason for rejecting this order.",
                confirmText: "Reject",
                confirmClass: "bg-red-600",
                icon: "block",
                iconClass: "bg-red-100 text-red-600",
                onConfirm: (reason) => {
                    const reasonInput = form.querySelector('.action-reason');
                    if (reasonInput) reasonInput.value = reason;
                    form.submit();
                }
            });
        }
    </script>
}

