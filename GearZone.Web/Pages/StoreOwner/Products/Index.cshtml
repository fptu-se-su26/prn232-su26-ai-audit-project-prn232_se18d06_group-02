@page "/storeowner/products"
@model GearZone.Web.Pages.StoreOwner.Products.IndexModel
@{
    ViewData["Title"] = "Product Management";
    ViewData["PageHeader"] = "Product Management";
    ViewData["ActivePage"] = "Products";
    ViewData["Breadcrumb"] = new string[] { "Products" };
    Layout = "_StoreOwnerLayout";
}

<div class="flex flex-col gap-6">
    <!-- Header with Action -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Products</h1>
            <p class="text-sm text-slate-500 font-medium">Manage your store's product catalog and inventory.</p>
        </div>
        <a asp-page="/StoreOwner/Products/Create" class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark text-white px-5 py-2.5 rounded-xl font-semibold shadow-sm shadow-blue-500/25 transition-all">
            <span class="material-symbols-outlined text-[20px]">add_circle</span>
            <span>Add New Product</span>
        </a>
    </div>

    <!-- Stats Overview (Widgets) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total Products -->
        <div class="bg-white p-4 rounded-xl shadow-card border border-slate-100 flex items-center gap-4">
            <div class="size-12 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center border border-blue-100/50">
                <span class="material-symbols-outlined">inventory_2</span>
            </div>
            <div>
                <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Total Products</p>
                <h3 class="text-2xl font-bold text-slate-900">@Model.Stats.TotalProducts.ToString("N0")</h3>
            </div>
        </div>

        <!-- Active Products -->
        <div class="bg-white p-4 rounded-xl shadow-card border border-slate-100 flex items-center gap-4">
            <div class="size-12 rounded-lg bg-green-50 text-green-600 flex items-center justify-center border border-green-100/50">
                <span class="material-symbols-outlined">check_circle</span>
            </div>
            <div>
                <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Active Products</p>
                <h3 class="text-2xl font-bold text-slate-900">@Model.Stats.ActiveProducts.ToString("N0")</h3>
            </div>
        </div>

        <!-- Out of Stock -->
        <div class="bg-white p-4 rounded-xl shadow-card border border-slate-100 flex items-center gap-4">
            <div class="size-12 rounded-lg bg-red-50 text-red-600 flex items-center justify-center border border-red-100/50">
                <span class="material-symbols-outlined">running_with_errors</span>
            </div>
            <div>
                <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Out of Stock</p>
                <h3 class="text-2xl font-bold text-slate-900">@Model.Stats.OutofStockProducts.ToString("N0")</h3>
            </div>
        </div>

        <!-- Pending/Draft -->
        <div class="bg-white p-4 rounded-xl shadow-card border border-slate-100 flex items-center gap-4">
            <div class="size-12 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center border border-amber-100/50">
                <span class="material-symbols-outlined">pending</span>
            </div>
            <div>
                <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Pending/Draft</p>
                <h3 class="text-2xl font-bold text-slate-900">@(Model.Stats.PendingProducts + Model.Stats.DraftProducts)</h3>
            </div>
        </div>
    </div>

    <!-- Filters Section (Form) -->
    <form method="get" id="filter-form" class="flex flex-col gap-4">
        <input type="hidden" name="PageNumber" id="page-number-input" value="@Model.PageNumber" />
        <input type="hidden" name="SortBy" id="sort-by-input" value="@Model.SortBy" />
        <input type="hidden" name="SortDirection" id="sort-dir-input" value="@Model.SortDirection" />
        <input type="hidden" name="Status" id="status-input" value="@Model.Status" />

        <!-- Status Tabs -->
        <div class="flex border-b border-slate-200 overflow-x-auto no-scrollbar">
            @{
                string TabClass(string? status)
                {
                    bool isActive = Model.Status == status;
                    return isActive 
                        ? "px-6 py-3 text-sm font-bold border-b-2 border-primary text-primary whitespace-nowrap" 
                        : "px-6 py-3 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-700 hover:bg-slate-50 whitespace-nowrap transition-all";
                }
            }
            <button type="button" class="@TabClass(null)" onclick="setStatusAndSubmit('')">All Products</button>
            <button type="button" class="@TabClass("Active")" onclick="setStatusAndSubmit('Active')">Active</button>
            <button type="button" class="@TabClass("Draft")" onclick="setStatusAndSubmit('Draft')">Draft</button>
            <button type="button" class="@TabClass("Pending")" onclick="setStatusAndSubmit('Pending')">Pending</button>
            <button type="button" class="@TabClass("Inactive")" onclick="setStatusAndSubmit('Inactive')">Inactive</button>
            <button type="button" class="@TabClass("Rejected")" onclick="setStatusAndSubmit('Rejected')">Rejected</button>
        </div>

        <!-- Filters & Actions Bar Card -->
        <div class="bg-white rounded-b-xl shadow-card border border-slate-100 overflow-hidden flex flex-col">
            <!-- Primary toolbar -->
            <div class="flex flex-col lg:flex-row gap-3 p-4 items-start lg:items-center">
                <!-- Search box -->
                <div class="relative flex-1 w-full">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400 pointer-events-none">
                        <span class="material-symbols-outlined text-[20px]">search</span>
                    </span>
                    <input asp-for="SearchTerm"
                           class="form-input w-full rounded-lg border-slate-200 bg-slate-50 pl-10 pr-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-primary focus:ring-primary focus:bg-white transition-colors"
                           placeholder="Search by name, category, brand..."
                           type="text"
                           autocomplete="off" />
                </div>

                <!-- Toolbar actions -->
                <div class="flex items-center gap-2 shrink-0 w-full lg:w-auto">
                    <button type="submit"
                            class="flex-1 lg:flex-none flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark text-white px-4 py-2.5 rounded-lg text-sm font-medium shadow-sm shadow-blue-500/20 transition-all">
                        <span class="material-symbols-outlined text-[18px]">search</span>
                        <span>Search</span>
                    </button>

                    <button type="button" id="toggle-advanced-btn"
                            class="flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:border-slate-300 transition-colors shadow-sm text-sm whitespace-nowrap">
                        <span class="material-symbols-outlined text-[18px]">tune</span>
                        <span class="hidden sm:inline font-medium">Filters</span>
                        @{
                            var advancedActiveCount = 0;
                            if (Model.CategoryId.HasValue) advancedActiveCount++;
                            if (Model.BrandId.HasValue) advancedActiveCount++;
                        }
                        @if (advancedActiveCount > 0)
                        {
                            <span class="inline-flex items-center justify-center size-5 rounded-full bg-primary text-white text-[10px] font-bold">@advancedActiveCount</span>
                        }
                    </button>

                    <a asp-page="/StoreOwner/Products/Index"
                       class="flex items-center justify-center p-2.5 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50 hover:text-slate-800 transition-colors bg-white shadow-sm"
                       title="Reset all filters">
                        <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                    </a>
                </div>
            </div>

            <!-- Advanced Filters (Collapsible) -->
            <div id="advanced-filters"
                 class="@(advancedActiveCount > 0 ? "" : "hidden") border-t border-slate-100 bg-slate-50/40 px-4 pt-4 pb-5 flex flex-col gap-5">

                <div class="flex flex-wrap lg:flex-nowrap items-start gap-4 lg:gap-6">
                    <!-- Category Filter -->
                    <div class="w-full lg:w-64 space-y-1 lg:shrink-0">
                        <label class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">category</span> Category
                        </label>
                        <select asp-for="CategoryId" class="form-select w-full rounded-lg border-slate-200 bg-white py-2 text-sm focus:ring-primary focus:border-primary h-[40px]">
                            <option value="">All Categories</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Brand Filter -->
                    <div class="w-full lg:w-64 space-y-1 lg:shrink-0">
                        <label class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">brand_family</span> Brand
                        </label>
                        <select asp-for="BrandId" class="form-select w-full rounded-lg border-slate-200 bg-white py-2 text-sm focus:ring-primary focus:border-primary h-[40px]">
                            <option value="">All Brands</option>
                            @foreach (var brand in Model.Brands)
                            {
                                <option value="@brand.Id">@brand.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Apply button -->
                    <div class="w-full lg:w-auto mt-2 lg:mt-[22px] lg:ms-auto">
                        <button type="submit"
                                class="w-full sm:w-auto h-[40px] flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-900 text-white px-6 rounded-lg text-sm font-semibold transition-colors shadow-sm">
                            <span class="material-symbols-outlined text-[17px]">check</span>
                            Apply Filters
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- Products Table Card -->
    <div class="bg-white rounded-xl shadow-card border border-slate-100 overflow-hidden flex flex-col">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/50">
                        <th class="py-4 px-6 text-xs font-semibold uppercase tracking-wider text-slate-500">
                            <button type="button" class="sort-header inline-flex items-center gap-1 w-full hover:text-primary transition-colors group" data-col="name">
                                Product
                                <span class="sort-icon material-symbols-outlined text-[16px] transition-all @(Model.SortBy == "name" ? "text-primary" : "text-slate-300 group-hover:text-slate-400")">
                                    @(Model.SortBy == "name" && Model.SortDirection == "asc" ? "arrow_upward" : Model.SortBy == "name" && Model.SortDirection == "desc" ? "arrow_downward" : "unfold_more")
                                </span>
                            </button>
                        </th>
                        <th class="py-4 px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 hidden md:table-cell">Category / Brand</th>
                        <th class="py-4 px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 text-right">
                            <button type="button" class="sort-header inline-flex items-center justify-end gap-1 w-full hover:text-primary transition-colors group" data-col="price">
                                Price
                                <span class="sort-icon material-symbols-outlined text-[16px] transition-all @(Model.SortBy == "price" ? "text-primary" : "text-slate-300 group-hover:text-slate-400")">
                                    @(Model.SortBy == "price" && Model.SortDirection == "asc" ? "arrow_upward" : Model.SortBy == "price" && Model.SortDirection == "desc" ? "arrow_downward" : "unfold_more")
                                </span>
                            </button>
                        </th>
                        <th class="py-4 px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 text-center">
                            <button type="button" class="sort-header inline-flex items-center justify-center gap-1 w-full hover:text-primary transition-colors group" data-col="stock">
                                Stock
                                <span class="sort-icon material-symbols-outlined text-[16px] transition-all @(Model.SortBy == "stock" ? "text-primary" : "text-slate-300 group-hover:text-slate-400")">
                                    @(Model.SortBy == "stock" && Model.SortDirection == "asc" ? "arrow_upward" : Model.SortBy == "stock" && Model.SortDirection == "desc" ? "arrow_downward" : "unfold_more")
                                </span>
                            </button>
                        </th>
                        <th class="py-4 px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 text-center">Status</th>
                        <th class="py-4 px-6 text-xs font-semibold uppercase tracking-wider text-slate-500 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Products.Any())
                    {
                        foreach (var product in Model.Products)
                        {
                            <tr class="hover:bg-slate-50 transition-all cursor-pointer group/row" onclick="if(!event.target.closest('a, button, form, input')) window.location.href='@Url.Page("/StoreOwner/Products/Details", new { id = product.Id })'">
                                <td class="py-4 px-6 align-middle">
                                    <div class="flex items-center gap-3">
                                        <div class="size-12 rounded-lg border border-slate-100 overflow-hidden bg-slate-50 shrink-0">
                                            @if (!string.IsNullOrEmpty(product.PrimaryImageUrl))
                                            {
                                                <img src="@product.PrimaryImageUrl" class="size-full object-cover" alt="" />
                                            }
                                            else
                                            {
                                                <div class="size-full flex items-center justify-center text-slate-300">
                                                    <span class="material-symbols-outlined text-[24px]">image</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="min-w-0">
                                            <p class="text-sm font-bold text-slate-900 group-hover/row:text-primary transition-colors truncate">@product.Name</p>
                                            <p class="text-[11px] font-mono text-slate-400">ID: @product.Id.ToString().Substring(0, 8)</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-3 hidden md:table-cell align-middle whitespace-nowrap">
                                    <p class="text-sm font-semibold text-slate-700">@product.CategoryName</p>
                                    <p class="text-xs text-slate-500">@product.BrandName</p>
                                </td>
                                <td class="py-4 px-3 text-right text-sm font-bold text-slate-900 align-middle whitespace-nowrap">
                                    @product.BasePrice.ToString("N0") ₫
                                </td>
                                <td class="py-4 px-3 text-center align-middle whitespace-nowrap">
                                    @{
                                        var stockClass = product.TotalStock switch
                                        {
                                            0 => "text-red-600 font-bold",
                                            < 10 => "text-amber-600 font-bold",
                                            _ => "text-slate-600 font-medium"
                                        };
                                    }
                                    <span class="text-sm @stockClass">@product.TotalStock.ToString("N0")</span>
                                </td>
                                <td class="py-4 px-3 text-center align-middle whitespace-nowrap">
                                    @{
                                        var statusClass = product.Status switch
                                        {
                                            "Active" => "bg-green-50 text-green-700 ring-green-600/20",
                                            "Inactive" => "bg-slate-100 text-slate-600 ring-slate-600/10",
                                            "Draft" => "bg-blue-50 text-blue-700 ring-blue-600/20",
                                            "Pending" => "bg-amber-50 text-amber-700 ring-amber-600/20",
                                            "Rejected" => "bg-red-50 text-red-700 ring-red-600/20",
                                            _ => "bg-slate-50 text-slate-700 ring-slate-600/20"
                                        };
                                        var dotClass = product.Status switch
                                        {
                                            "Active" => "bg-green-600",
                                            "Inactive" => "bg-slate-400",
                                            "Draft" => "bg-blue-600",
                                            "Pending" => "bg-amber-500",
                                            "Rejected" => "bg-red-600",
                                            _ => "bg-slate-600"
                                        };
                                    }
                                    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1.5 text-xs font-semibold @statusClass ring-1 ring-inset">
                                        <span class="size-1.5 rounded-full @dotClass"></span> @product.Status
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-right align-middle whitespace-nowrap">
                                    <div class="relative inline-block text-left dropdown-container">
                                        <button type="button" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-all dropdown-toggle" title="Actions" onclick="event.stopPropagation(); toggleDropdown(this);">
                                            <span class="material-symbols-outlined text-[20px]">more_vert</span>
                                        </button>
                                        <div class="hidden absolute right-0 mt-2 w-48 rounded-xl bg-white shadow-lg ring-1 ring-black ring-opacity-5 z-[50] dropdown-menu divide-y divide-slate-100 overflow-hidden" onclick="event.stopPropagation();">
                                            <div class="py-1">
                                                <a asp-page="/StoreOwner/Products/Details" asp-route-id="@product.Id" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors">
                                                    <span class="material-symbols-outlined text-[18px] text-slate-400">visibility</span>
                                                    View Details
                                                </a>
                                                 <a asp-page="/StoreOwner/Products/Edit" asp-route-id="@product.Id" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors">
                                                     <span class="material-symbols-outlined text-[18px] text-slate-400">edit</span>
                                                     Edit Product
                                                 </a>
                                                 <a asp-page="/StoreOwner/Products/Create" asp-route-copyFromId="@product.Id" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors">
                                                     <span class="material-symbols-outlined text-[18px] text-slate-400">content_copy</span>
                                                     Copy Product
                                                 </a>
                                                  @if (product.Status == "Active" || product.Status == "Approved")
                                                  {
                                                      <a href="/product/@product.Slug" target="_blank" class="flex items-center gap-2 px-4 py-2 text-sm text-emerald-600 hover:bg-emerald-50 transition-colors">
                                                          <span class="material-symbols-outlined text-[18px]">open_in_new</span>
                                                          View Live
                                                      </a>
                                                  }
                                                  else
                                                  {
                                                      <a asp-page="/Public/Catalog/Preview" asp-route-id="@product.Id" target="_blank" class="flex items-center gap-2 px-4 py-2 text-sm text-blue-600 hover:bg-blue-50 transition-colors">
                                                          <span class="material-symbols-outlined text-[18px]">visibility</span>
                                                          Live Preview
                                                      </a>
                                                  }
                                            </div>
                                            <div class="py-1">
                                                @{
                                                    var canToggle = product.Status == "Active" || product.Status == "Approved" || product.Status == "Inactive";
                                                }
                                                @if (canToggle)
                                                {
                                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@product.Id">
                                                        @{
                                                            var isActiveLike = product.Status == "Active" || product.Status == "Approved";
                                                            var toggleText = isActiveLike ? "Deactivate" : "Activate";
                                                            var toggleIcon = isActiveLike ? "toggle_off" : "toggle_on";
                                                            var toggleColor = isActiveLike ? "text-red-600" : "text-green-600";
                                                            var swalIcon = isActiveLike ? "warning" : "question";
                                                        }
                                                        <button type="button" onclick="handleConfirm(this, '@toggleText Product', 'Are you sure you want to @toggleText.ToLower() this product?', '@toggleIcon', '@(isActiveLike ? "bg-red-100 text-red-600" : "bg-emerald-100 text-emerald-600")' , '@(isActiveLike ? "bg-red-600" : "bg-primary")')" class="flex w-full items-center gap-2 px-4 py-2 text-sm @toggleColor hover:bg-slate-50 transition-colors">
                                                            <span class="material-symbols-outlined text-[18px]">@toggleIcon</span>
                                                            @toggleText Product
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-500">
                                <div class="flex flex-col items-center justify-center space-y-3">
                                    <div class="size-16 rounded-full bg-slate-50 flex items-center justify-center">
                                        <span class="material-symbols-outlined text-4xl text-slate-300">inventory_2</span>
                                    </div>
                                    <p class="text-base font-medium text-slate-900 mt-2">No products found</p>
                                    <p class="text-sm">We couldn't find any products matching your criteria.</p>
                                    <button type="button" class="mt-2 text-sm text-primary font-medium hover:underline" onclick="window.location.href='/storeowner/products'">Clear all filters</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="border-t border-slate-100 px-6 py-4 bg-slate-50/30 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="text-sm text-slate-500">
                Showing <span class="font-medium text-slate-900">@((Model.PageNumber - 1) * Model.PageSize + (Model.Products.Any() ? 1 : 0))</span> to
                <span class="font-medium text-slate-900">
                    @(System.Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))
                </span> of
                <span class="font-medium text-slate-900">@Model.TotalCount.ToString("N0")</span> products
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Pagination" class="flex items-center gap-1">
                    @if (Model.PageNumber > 1)
                    {
                        <button type="button" onclick="gotoPage(@(Model.PageNumber - 1))" class="p-2 rounded-lg border border-slate-200 text-slate-400 hover:bg-white hover:text-primary hover:border-primary transition-all shadow-sm">
                            <span class="material-symbols-outlined text-lg leading-none">chevron_left</span>
                        </button>
                    }
                    else
                    {
                        <div class="p-2 rounded-lg border border-slate-100 text-slate-300 bg-slate-50 cursor-not-allowed">
                            <span class="material-symbols-outlined text-lg leading-none">chevron_left</span>
                        </div>
                    }

                    <div class="flex items-center gap-1 px-1">
                        @{
                            int startPage = System.Math.Max(1, Model.PageNumber - 2);
                            int endPage = System.Math.Min(Model.TotalPages, startPage + 4);
                            if (endPage - startPage < 4 && startPage > 1)
                            {
                                startPage = System.Math.Max(1, endPage - 4);
                            }
                        }
                        
                        @if (startPage > 1)
                        {
                            <button type="button" onclick="gotoPage(1)" class="min-w-[36px] h-9 flex items-center justify-center rounded-lg text-sm font-medium transition-all border border-transparent text-slate-600 hover:border-slate-200 hover:bg-white hover:text-primary">1</button>
                            @if (startPage > 2)
                            {
                                <span class="text-slate-400 px-1">...</span>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <button type="button" @(i != Model.PageNumber ? $"onclick=gotoPage({i})" : "") class="min-w-[36px] h-9 flex items-center justify-center rounded-lg text-sm font-medium transition-all @(i == Model.PageNumber ? "bg-primary text-white shadow-sm shadow-blue-500/20" : "border border-transparent text-slate-600 hover:border-slate-200 hover:bg-white hover:text-primary")">
                                @i
                            </button>
                        }

                        @if (endPage < Model.TotalPages)
                        {
                            @if (endPage < Model.TotalPages - 1)
                            {
                                <span class="text-slate-400 px-1">...</span>
                            }
                            <button type="button" onclick="gotoPage(@Model.TotalPages)" class="min-w-[36px] h-9 flex items-center justify-center rounded-lg text-sm font-medium transition-all border border-transparent text-slate-600 hover:border-slate-200 hover:bg-white hover:text-primary">@Model.TotalPages</button>
                        }
                    </div>

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <button type="button" onclick="gotoPage(@(Model.PageNumber + 1))" class="p-2 rounded-lg border border-slate-200 text-slate-400 hover:bg-white hover:text-primary hover:border-primary transition-all shadow-sm">
                            <span class="material-symbols-outlined text-lg leading-none">chevron_right</span>
                        </button>
                    }
                    else
                    {
                        <div class="p-2 rounded-lg border border-slate-100 text-slate-300 bg-slate-50 cursor-not-allowed">
                            <span class="material-symbols-outlined text-lg leading-none">chevron_right</span>
                        </div>
                    }
                </nav>
            }
        </div>
    </div>
</div>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .shadow-card {
        box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
    }
</style>

@section Scripts {
    <script>
        function handleConfirm(btn, title, text, icon, iconClass, btnClass) {
            const form = btn.closest('form');
            window.showConfirmModal({
                title: title,
                message: text,
                confirmText: "Confirm",
                confirmClass: btnClass,
                icon: icon,
                iconClass: iconClass,
                onConfirm: () => form.submit()
            });
        }

        function gotoPage(page) {
            const pageInput = document.getElementById('page-number-input');
            const filterForm = document.getElementById('filter-form');
            if (pageInput && filterForm) {
                pageInput.value = page;
                filterForm.submit();
            }
        }

        function setStatusAndSubmit(status) {
            const statusInput = document.getElementById('status-input');
            const filterForm = document.getElementById('filter-form');
            const pageInput = document.getElementById('page-number-input');
            if (statusInput && filterForm) {
                statusInput.value = status;
                if (pageInput) pageInput.value = 1;
                filterForm.submit();
            }
        }

        function toggleDropdown(btn) {
            // Close all other dropdowns
            document.querySelectorAll('.dropdown-menu').forEach(menu => {
                if (menu !== btn.nextElementSibling) {
                    menu.classList.add('hidden');
                    menu.parentElement.querySelector('.dropdown-toggle').classList.remove('bg-slate-100', 'text-slate-600');
                }
            });

            const menu = btn.nextElementSibling;
            const isHidden = menu.classList.contains('hidden');
            
            if (isHidden) {
                menu.classList.remove('hidden');
                btn.classList.add('bg-slate-100', 'text-slate-600');
            } else {
                menu.classList.add('hidden');
                btn.classList.remove('bg-slate-100', 'text-slate-600');
            }
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.dropdown-container')) {
                document.querySelectorAll('.dropdown-menu').forEach(menu => {
                    menu.classList.add('hidden');
                    menu.parentElement.querySelector('.dropdown-toggle').classList.remove('bg-slate-100', 'text-slate-600');
                });
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            const toggleAdvancedBtn = document.getElementById('toggle-advanced-btn');
            const advancedFilters = document.getElementById('advanced-filters');

            if (advancedFilters && !advancedFilters.classList.contains('hidden')) {
                toggleAdvancedBtn?.classList.add('bg-slate-50', 'border-slate-300', 'text-slate-900');
            }

            if (toggleAdvancedBtn) {
                toggleAdvancedBtn.addEventListener('click', function() {
                    advancedFilters.classList.toggle('hidden');
                    if (advancedFilters.classList.contains('hidden')) {
                        this.classList.remove('bg-slate-50', 'text-slate-900', 'border-slate-300');
                    } else {
                        this.classList.add('bg-slate-50', 'text-slate-900', 'border-slate-300');
                    }
                });
            }

            const sortByInput = document.getElementById('sort-by-input');
            const sortDirInput = document.getElementById('sort-dir-input');
            const filterForm = document.getElementById('filter-form');

            document.querySelectorAll('.sort-header').forEach(btn => {
                btn.addEventListener('click', function () {
                    const col = this.dataset.col;
                    const currentCol = sortByInput.value;
                    const currentDir = sortDirInput.value;

                    let nextDir = '';
                    if (currentCol !== col) {
                        nextDir = 'desc';
                    } else if (currentDir === 'desc') {
                        nextDir = 'asc';
                    } else if (currentDir === 'asc') {
                        nextDir = '';
                    } else {
                        nextDir = 'desc';
                    }

                    if (nextDir === '') {
                        sortByInput.value = '';
                        sortDirInput.value = '';
                    } else {
                        sortByInput.value = col;
                        sortDirInput.value = nextDir;
                    }

                    const pageInput = document.getElementById('page-number-input');
                    if (pageInput) pageInput.value = '1';

                    filterForm.submit();
                });
            });
        });
    </script>
}

