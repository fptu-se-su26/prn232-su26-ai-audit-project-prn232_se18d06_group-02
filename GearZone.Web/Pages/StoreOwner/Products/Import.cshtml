@page "/storeowner/products/import"
@model GearZone.Web.Pages.StoreOwner.Products.ImportModel
@{
    ViewData["Title"] = "Import Products";
    ViewData["PageHeader"] = "Import Products";
    ViewData["ActivePage"] = "Products";
    ViewData["Breadcrumb"] = new string[] { "Products", "Import" };
    Layout = "_StoreOwnerLayout";

    string Money(decimal v) => v.ToString("N0") + " ₫";

    string ActionBadge(string a) => a switch
    {
        "Restock" => "bg-blue-50 text-blue-700",
        "New variant" => "bg-violet-50 text-violet-700",
        "New product" => "bg-emerald-50 text-emerald-700",
        _ => "bg-slate-100 text-slate-400"
    };
}

<div class="flex flex-col gap-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Import products from Excel</h1>
            <p class="text-sm text-slate-500 font-medium">Bulk-add products &amp; variants from an .xlsx file. Imported products are created as <span class="font-semibold">Draft</span>.</p>
        </div>
        <a asp-page="/StoreOwner/Products/Index" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-primary">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span> Back to products
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">@Model.Error</div>
    }

    <!-- Upload card -->
    <div class="rounded-xl border border-slate-100 bg-white p-6 shadow-card">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div>
                <h3 class="text-base font-bold text-slate-900">1 · Prepare your file</h3>
                <p class="mt-0.5 text-sm text-slate-500">Download the template, fill it in, then upload. One row = one variant; repeat the same ProductName to add variants.</p>
            </div>
            <a asp-page-handler="Template" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition-colors hover:border-primary hover:text-primary">
                <span class="material-symbols-outlined text-[18px]">download</span>
                Download template (.xlsx)
            </a>
        </div>

        <form method="post" asp-page-handler="Preview" enctype="multipart/form-data" class="flex flex-wrap items-center gap-3 border-t border-slate-100 pt-4">
            <input type="file" name="Upload" accept=".xlsx"
                   class="block text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-100 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-slate-700 hover:file:bg-slate-200" />
            <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 font-semibold text-white shadow-sm shadow-blue-500/25 transition-all hover:bg-primary-dark">
                <span class="material-symbols-outlined text-[20px]">search_check</span>
                Validate &amp; preview
            </button>
        </form>
    </div>

    @if (Model.Result != null)
    {
        var res = Model.Result;
        <!-- Import result -->
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-6 shadow-card">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-[28px] text-emerald-600">task_alt</span>
                <div>
                    <h3 class="text-base font-bold text-emerald-800">Import complete</h3>
                    <p class="text-sm text-emerald-700">
                        Created <strong>@res.ProductsCreated</strong> product(s), added <strong>@res.VariantsCreated</strong> new variant(s), restocked <strong>@res.VariantsRestocked</strong> variant(s).
                        @if (res.RowsSkipped > 0) { <text> Skipped <strong>@res.RowsSkipped</strong> row(s).</text> }
                    </p>
                </div>
            </div>
            @if (res.Errors.Count > 0)
            {
                <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
                    <p class="mb-1 font-semibold">Some products were not created:</p>
                    <ul class="list-disc pl-5">
                        @foreach (var e in res.Errors) { <li>@e</li> }
                    </ul>
                </div>
            }
            <div class="mt-4 flex gap-3">
                <a asp-page="/StoreOwner/Products/Index" class="inline-flex items-center gap-2 rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900">
                    <span class="material-symbols-outlined text-[18px]">inventory_2</span> Go to products
                </a>
                <a asp-page="/StoreOwner/Products/Import" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:border-primary hover:text-primary">
                    Import another file
                </a>
            </div>
        </div>
    }
    else if (Model.Preview != null)
    {
        var pv = Model.Preview;
        <!-- Preview -->
        <div class="rounded-xl border border-slate-100 bg-white shadow-card">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 p-5">
                <div>
                    <h3 class="text-base font-bold text-slate-900">2 · Preview &amp; confirm</h3>
                    <p class="mt-0.5 text-sm text-slate-500">Review the rows below, then confirm to create the valid ones. Invalid rows are skipped.</p>
                </div>
                <form method="post" asp-page-handler="Confirm">
                    <input type="hidden" name="FileData" value="@Model.FileData" />
                    <button type="submit" @(pv.ValidRows == 0 ? "disabled" : "")
                            class="inline-flex items-center gap-2 rounded-xl px-5 py-2.5 font-semibold text-white shadow-sm transition-all @(pv.ValidRows == 0 ? "cursor-not-allowed bg-slate-300" : "bg-emerald-600 hover:bg-emerald-700 shadow-emerald-500/25")">
                        <span class="material-symbols-outlined text-[20px]">upload</span>
                        Import @pv.ValidRows valid row(s)
                    </button>
                </form>
            </div>

            <div class="flex flex-wrap gap-4 border-b border-slate-100 p-5">
                <div class="rounded-lg bg-slate-50 px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total rows</p>
                    <p class="mt-1 text-2xl font-bold text-slate-900">@pv.TotalRows</p>
                </div>
                <div class="rounded-lg bg-emerald-50 px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Valid</p>
                    <p class="mt-1 text-2xl font-bold text-emerald-700">@pv.ValidRows</p>
                </div>
                <div class="rounded-lg bg-red-50 px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-wider text-red-500">Invalid</p>
                    <p class="mt-1 text-2xl font-bold text-red-700">@pv.InvalidRows</p>
                </div>
                <div class="rounded-lg bg-emerald-50 px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">New products</p>
                    <p class="mt-1 text-2xl font-bold text-emerald-700">@pv.ProductCount</p>
                </div>
                <div class="rounded-lg bg-violet-50 px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">New variants</p>
                    <p class="mt-1 text-2xl font-bold text-violet-700">@pv.NewVariants</p>
                </div>
                <div class="rounded-lg bg-blue-50 px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-wider text-blue-600">Restocks</p>
                    <p class="mt-1 text-2xl font-bold text-blue-700">@pv.Restocks</p>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 bg-slate-50/50 text-xs font-semibold uppercase tracking-wider text-slate-500">
                            <th class="px-4 py-3 text-right">Row</th>
                            <th class="px-4 py-3">Product</th>
                            <th class="px-4 py-3">Variant</th>
                            <th class="px-4 py-3">SKU</th>
                            <th class="px-4 py-3 text-right">Price</th>
                            <th class="px-4 py-3 text-right">Stock</th>
                            <th class="px-4 py-3">Action</th>
                            <th class="px-4 py-3">Status</th>
                            <th class="px-4 py-3">Issues</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var r in pv.Rows)
                        {
                            <tr class="@(r.IsValid ? "hover:bg-slate-50" : "bg-red-50/40")">
                                <td class="px-4 py-3 text-right text-slate-400">@r.RowNumber</td>
                                <td class="px-4 py-3">
                                    <div class="font-medium text-slate-800">@r.ProductName</div>
                                    <div class="text-xs text-slate-400">@r.Category · @r.Brand</div>
                                </td>
                                <td class="px-4 py-3 text-slate-600">@r.VariantName</td>
                                <td class="px-4 py-3 font-mono text-xs text-slate-500">@r.Sku</td>
                                <td class="px-4 py-3 text-right text-slate-700">@Money(r.Price)</td>
                                <td class="px-4 py-3 text-right text-slate-700">@r.Stock</td>
                                <td class="px-4 py-3">
                                    @if (!string.IsNullOrEmpty(r.Action))
                                    {
                                        <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold @ActionBadge(r.Action)">@r.Action</span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    @if (r.IsValid)
                                    {
                                        <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">Valid</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700">Invalid</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-xs text-red-600">@string.Join(" · ", r.Errors)</td>
                            </tr>
                        }
                        @if (pv.Rows.Count == 0)
                        {
                            <tr><td colspan="9" class="py-12 text-center text-slate-400">No data rows found in the file.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
