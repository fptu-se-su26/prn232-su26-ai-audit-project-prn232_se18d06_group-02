@page "/storeowner/promotions/manage/{id:guid?}"
@model GearZone.Web.Pages.StoreOwner.Promotions.ManageModel
@using GearZone.Domain.Enums
@{
    ViewData["Title"] = Model.IsEdit ? "Edit Promotion" : "Create Promotion";
    ViewData["PageHeader"] = ViewData["Title"];
    ViewData["ActivePage"] = "Promotions";
    ViewData["Breadcrumb"] = new[] { "Marketing", "Promotions", Model.IsEdit ? "Edit" : "Create" };
    Layout = "_StoreOwnerLayout";
}

<form method="post" class="mx-auto max-w-5xl space-y-6">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700"></div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">@(Model.IsEdit ? "Edit campaign" : "Create campaign")</h1>
            <p class="mt-1 text-sm text-slate-500">The discount applies automatically to every variant of each selected product.</p>
        </div>
        <div class="flex gap-3">
            <a asp-page="./Index" class="rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</a>
            <button class="rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-dark">Save campaign</button>
        </div>
    </div>

    <section class="rounded-xl border border-slate-100 bg-white p-6 shadow-card">
        <h2 class="text-lg font-bold text-slate-800">Campaign details</h2>
        <div class="mt-5 grid gap-5 md:grid-cols-2">
            <div class="md:col-span-2">
                <label asp-for="Input.Name" class="mb-1.5 block text-sm font-semibold text-slate-700">Name</label>
                <input asp-for="Input.Name" class="w-full rounded-lg border-slate-200 focus:border-primary focus:ring-primary" placeholder="e.g. Weekend keyboard sale" />
                <span asp-validation-for="Input.Name" class="mt-1 block text-xs text-rose-600"></span>
            </div>
            <div class="md:col-span-2">
                <label asp-for="Input.Description" class="mb-1.5 block text-sm font-semibold text-slate-700">Description</label>
                <textarea asp-for="Input.Description" rows="3" class="w-full rounded-lg border-slate-200 focus:border-primary focus:ring-primary" placeholder="Internal campaign note or customer-facing terms"></textarea>
            </div>
            <div>
                <label asp-for="Input.DiscountType" class="mb-1.5 block text-sm font-semibold text-slate-700">Discount type</label>
                <select asp-for="Input.DiscountType" class="w-full rounded-lg border-slate-200 focus:border-primary focus:ring-primary">
                    <option value="@DiscountType.Percent">Percentage</option>
                    <option value="@DiscountType.FixedAmount">Fixed amount per unit</option>
                </select>
            </div>
            <div>
                <label asp-for="Input.DiscountValue" class="mb-1.5 block text-sm font-semibold text-slate-700">Discount value</label>
                <input asp-for="Input.DiscountValue" class="w-full rounded-lg border-slate-200 focus:border-primary focus:ring-primary" />
                <span asp-validation-for="Input.DiscountValue" class="mt-1 block text-xs text-rose-600"></span>
            </div>
            <div>
                <label asp-for="Input.StartAt" class="mb-1.5 block text-sm font-semibold text-slate-700">Starts at</label>
                <input asp-for="Input.StartAt" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="w-full rounded-lg border-slate-200 focus:border-primary focus:ring-primary" />
            </div>
            <div>
                <label asp-for="Input.EndAt" class="mb-1.5 block text-sm font-semibold text-slate-700">Ends at</label>
                <input asp-for="Input.EndAt" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="w-full rounded-lg border-slate-200 focus:border-primary focus:ring-primary" />
            </div>
            <div>
                <label asp-for="Input.TotalQuantityLimit" class="mb-1.5 block text-sm font-semibold text-slate-700">Total unit quota</label>
                <input asp-for="Input.TotalQuantityLimit" class="w-full rounded-lg border-slate-200 focus:border-primary focus:ring-primary" />
                <p class="mt-1 text-xs text-slate-500">Shared across all selected products and variants.</p>
                <span asp-validation-for="Input.TotalQuantityLimit" class="mt-1 block text-xs text-rose-600"></span>
            </div>
            <label class="flex items-center gap-3 self-end rounded-lg border border-slate-200 px-4 py-3">
                <input asp-for="Input.IsEnabled" class="rounded border-slate-300 text-primary focus:ring-primary" />
                <span>
                    <span class="block text-sm font-semibold text-slate-700">Enable campaign</span>
                    <span class="block text-xs text-slate-500">The time window and quota still determine availability.</span>
                </span>
            </label>
        </div>
    </section>

    <section class="rounded-xl border border-slate-100 bg-white p-6 shadow-card">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <h2 class="text-lg font-bold text-slate-800">Products</h2>
                <p class="mt-1 text-sm text-slate-500">Only products owned by your store are available.</p>
            </div>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-2.5 text-lg text-slate-400">search</span>
                <input id="productSearch" type="search" class="rounded-lg border-slate-200 py-2 pl-10 text-sm focus:border-primary focus:ring-primary" placeholder="Filter products" />
            </div>
        </div>
        <span asp-validation-for="Input.ProductIds" class="mt-3 block text-xs text-rose-600"></span>

        @if (!Model.Products.Any())
        {
            <div class="mt-5 rounded-lg border border-dashed border-slate-300 p-10 text-center text-sm text-slate-500">No eligible products are available.</div>
        }
        else
        {
            <div id="productGrid" class="mt-5 grid max-h-[30rem] gap-3 overflow-y-auto pr-1 md:grid-cols-2">
                @foreach (var product in Model.Products)
                {
                    <label class="product-option flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-4 hover:border-primary/50 hover:bg-blue-50/40" data-name="@product.Name.ToLowerInvariant()">
                        <input type="checkbox" name="Input.ProductIds" value="@product.Id"
                               checked="@Model.Input.ProductIds.Contains(product.Id)"
                               class="mt-1 rounded border-slate-300 text-primary focus:ring-primary" />
                        <span class="min-w-0">
                            <span class="block truncate text-sm font-semibold text-slate-800">@product.Name</span>
                            <span class="mt-1 block text-xs text-slate-500">From @product.MinimumVariantPrice.ToString("N0") VND</span>
                        </span>
                    </label>
                }
            </div>
        }
    </section>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('productSearch')?.addEventListener('input', function () {
            const term = this.value.trim().toLowerCase();
            document.querySelectorAll('.product-option').forEach(option => {
                option.classList.toggle('hidden', !option.dataset.name.includes(term));
            });
        });
    </script>
}
