@model GearZone.Web.Pages.Shared.Models.ReviewStarsViewModel
@{
    var maxStars = Model.MaxStars <= 0 ? 5 : Model.MaxStars;
    var filledStars = Math.Clamp((int)Math.Round(Model.Rating, MidpointRounding.AwayFromZero), 0, maxStars);
    var ariaLabel = string.IsNullOrWhiteSpace(Model.AriaLabel)
        ? $"{Model.Rating:0.#} out of {maxStars} stars"
        : Model.AriaLabel;
}

<span class="review-stars" role="img" aria-label="@ariaLabel" style="--review-star-size:@(Model.SizePx)px;">
    @for (var index = 1; index <= maxStars; index++)
    {
        <svg viewBox="0 0 24 24"
             class="review-star @(index <= filledStars ? "review-star--filled" : "review-star--empty")"
             aria-hidden="true"
             focusable="false">
            <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.258 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.372 21.18c-.996.608-2.231-.29-1.96-1.425l1.258-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006Z" />
        </svg>
    }
</span>
