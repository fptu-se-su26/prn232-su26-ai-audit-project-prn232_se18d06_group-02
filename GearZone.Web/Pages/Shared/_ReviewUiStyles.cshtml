<style>
    :root {
        --review-star-fill: #ee4d2d;
        --review-star-empty: #d8dde6;
        --review-accent: #ee4d2d;
        --review-accent-strong: #d73211;
        --review-accent-soft: #fff6f3;
        --review-accent-band: #fff8f5;
        --review-accent-border: #f3d3c7;
        --review-border: #f0f0f0;
        --review-divider: #f5f5f5;
        --review-muted: #767676;
        --review-muted-soft: #9aa4b2;
        --review-neutral-bg: #fff;
        --review-neutral-soft: #fafafa;
        --review-info-bg: #f7f9fc;
        --review-transition: 160ms ease;
    }

    .review-stars {
        display: inline-flex;
        align-items: center;
        gap: 0.18rem;
        line-height: 1;
    }

    .review-star {
        width: var(--review-star-size, 16px);
        height: var(--review-star-size, 16px);
        display: block;
        flex: none;
    }

    .review-star--filled {
        color: var(--review-star-fill);
    }

    .review-star--empty {
        color: var(--review-star-empty);
    }

    .review-panel-shell,
    .review-surface-card {
        background: var(--review-neutral-bg);
        border: 1px solid var(--review-border);
        box-shadow: none;
    }

    .review-section-shell {
        background: var(--review-neutral-bg);
        border: 1px solid var(--review-border);
    }

    .review-section-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.5rem 2rem 0;
    }

    .review-section-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #222;
    }

    .review-section-subtitle {
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: var(--review-muted);
    }

    .review-summary-band {
        border: 1px solid #f6e7de;
        background: var(--review-accent-band);
        border-radius: 0.125rem;
        padding: 1.75rem 2rem;
    }

    .review-summary-score {
        font-size: 1.9rem;
        font-weight: 700;
        line-height: 1;
        color: var(--review-accent);
    }

    .review-summary-score span {
        font-size: 2rem;
    }

    .review-summary-copy {
        margin-top: 0.5rem;
        font-size: 0.875rem;
        color: var(--review-muted);
    }

    .review-summary-caption {
        margin-top: 0.35rem;
        font-size: 0.75rem;
        color: var(--review-muted-soft);
    }

    .review-inline-kicker,
    .review-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #8b96a5;
    }

    .review-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        min-height: 2.05rem;
        padding: 0.45rem 1rem;
        border: 1px solid #ededed;
        border-radius: 0.125rem;
        background: #fff;
        color: #555;
        font-size: 0.875rem;
        font-weight: 500;
        transition: border-color var(--review-transition), color var(--review-transition), background-color var(--review-transition);
    }

    .review-chip:hover {
        border-color: #ee4d2d;
        color: #ee4d2d;
    }

    .review-chip.is-active {
        border-color: var(--review-accent);
        background: var(--review-accent-soft);
        color: var(--review-accent);
    }

    .review-chip-count {
        color: inherit;
        opacity: 0.75;
        font-size: 0.8125rem;
    }

    .review-action-link,
    .review-ghost-button,
    .review-primary-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border-radius: 0.25rem;
        font-size: 0.95rem;
        font-weight: 600;
        transition: border-color var(--review-transition), background-color var(--review-transition), color var(--review-transition);
    }

    .review-action-link {
        min-height: 2.4rem;
        padding: 0.55rem 1.15rem;
        border: 1px solid var(--review-accent-border);
        background: #fff;
        color: var(--review-accent);
    }

    .review-action-link:hover {
        border-color: var(--review-accent);
        background: var(--review-accent-soft);
    }

    .review-primary-button {
        min-height: 2.8rem;
        padding: 0.7rem 1.35rem;
        border: 1px solid var(--review-accent);
        background: var(--review-accent);
        color: #fff;
    }

    .review-primary-button:hover {
        background: var(--review-accent-strong);
        border-color: var(--review-accent-strong);
    }

    .review-ghost-button {
        min-height: 2.8rem;
        padding: 0.7rem 1.15rem;
        border: 1px solid #d9d9d9;
        background: #fff;
        color: #555;
    }

    .review-ghost-button:hover {
        border-color: #bfbfbf;
        background: #fafafa;
    }

    .review-page-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2rem;
        min-height: 2rem;
        border: 1px solid #e8e8e8;
        border-radius: 0.125rem;
        background: #fff;
        color: #555;
        font-size: 0.875rem;
        font-weight: 500;
        transition: border-color var(--review-transition), background-color var(--review-transition), color var(--review-transition);
    }

    .review-page-link:hover {
        border-color: #ee4d2d;
        color: #ee4d2d;
    }

    .review-page-link.is-active {
        border-color: var(--review-accent);
        background: var(--review-accent);
        color: #fff;
    }

    .review-page-link.is-disabled {
        border-color: #efefef;
        background: #fafafa;
        color: #c3c3c3;
        pointer-events: none;
    }

    .review-page-nav {
        min-width: 2.25rem;
        font-size: 1rem;
        font-weight: 700;
    }

    .review-page-ellipsis {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.75rem;
        min-height: 2rem;
        color: #888;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .review-eligible-card,
    .review-summary-shell {
        border: 1px solid #eef2f6;
        background: var(--review-info-bg);
        border-radius: 0.25rem;
    }

    .review-reply-card {
        border-left: 0.1875rem solid #f4a58d;
        background: #fafafa;
        border-radius: 0.125rem;
    }

    .review-avatar-fallback {
        background: #f6f8fb;
        color: #5c6773;
        border: 1px solid #e8edf3;
    }

    .review-soft-panel {
        border: 1px solid #f1f1f1;
        background: #fcfcfc;
    }

    .review-textarea {
        border: 1px solid #d9d9d9;
        background: #fff;
        transition: border-color var(--review-transition), box-shadow var(--review-transition);
    }

    .review-textarea:focus {
        border-color: var(--review-accent);
        box-shadow: 0 0 0 1px rgba(238, 77, 45, 0.1);
        outline: 0;
    }

    .review-panel-shell {
        transition: opacity var(--review-transition), transform var(--review-transition);
    }

    .review-panel-shell.is-review-loading {
        opacity: 0.58;
        transform: translateY(2px);
        pointer-events: none;
    }

    .review-panel-shell.review-panel-enter {
        opacity: 0;
        transform: translateY(10px);
    }

    .review-panel-shell.review-panel-enter.review-panel-enter-active {
        opacity: 1;
        transform: translateY(0);
    }

    .review-list-item {
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--review-divider);
    }

    .review-list-item:last-child {
        border-bottom: 0;
    }

    .review-meta-line {
        margin-top: 0.45rem;
        font-size: 0.75rem;
        color: var(--review-muted);
    }

    .review-user-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        background: #f6f6f6;
        padding: 0.15rem 0.55rem;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #8f8f8f;
        text-transform: uppercase;
    }

    .review-star-picker {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .review-star-picker__input {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .review-star-picker__label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--review-star-empty);
        transition: transform var(--review-transition), color var(--review-transition);
    }

    .review-star-picker__label:hover {
        transform: scale(1.04);
    }

    .review-star-picker__label.is-filled {
        color: var(--review-star-fill);
    }

    .review-star-picker__icon {
        width: 2.25rem;
        height: 2.25rem;
        display: block;
    }

    .review-star-picker__input:focus + .review-star-picker__label {
        outline: 2px solid rgba(238, 77, 45, 0.18);
        outline-offset: 0.15rem;
        border-radius: 0.25rem;
    }

    .review-rating-status {
        font-size: 1rem;
        font-weight: 600;
        color: #222;
    }

    .review-rating-status small {
        display: block;
        margin-top: 0.2rem;
        font-size: 0.85rem;
        font-weight: 400;
        color: var(--review-muted);
    }

    .review-divider {
        border-top: 1px solid var(--review-divider);
    }

    .review-flat-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 9999px;
        background: #f6f6f6;
        padding: 0.3rem 0.8rem;
        font-size: 0.75rem;
        color: var(--review-muted);
    }

    .review-flat-badge--accent {
        color: var(--review-accent);
        background: var(--review-accent-soft);
    }

    .material-symbols-outlined.filled {
        font-variation-settings: 'FILL' 1;
    }

    @@media (max-width: 768px) {
        .review-section-header {
            padding: 1.25rem 1rem 0;
        }

        .review-summary-band {
            padding: 1.25rem 1rem;
        }

        .review-star-picker__icon {
            width: 1.95rem;
            height: 1.95rem;
        }

        .review-chip {
            padding: 0.45rem 0.85rem;
            font-size: 0.8125rem;
        }
    }
</style>
