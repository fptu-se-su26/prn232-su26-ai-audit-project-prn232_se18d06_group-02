<style>
    .ai-chat-widget {
        --ai-accent: #e94f24;
        --ai-accent-dark: #c93b16;
        --ai-ink: #172033;
        --ai-muted: #667085;
        --ai-line: #e8ebf0;
        position: fixed;
        right: 18px;
        bottom: 58px;
        z-index: 72;
        font-family: Inter, sans-serif;
        pointer-events: none;
    }

    .ai-chat-widget > * {
        pointer-events: auto;
    }

    .ai-chat-widget__launcher {
        display: inline-flex;
        min-height: 46px;
        align-items: center;
        gap: 8px;
        border: 0;
        border-radius: 8px 8px 0 0;
        background: var(--ai-accent);
        color: #fff;
        padding: 0 15px;
        font-size: 14px;
        font-weight: 750;
        box-shadow: 0 8px 22px rgba(201, 59, 22, .24);
        transition: background-color .16s ease, transform .16s ease, opacity .16s ease;
    }

    .ai-chat-widget__launcher:hover {
        background: var(--ai-accent-dark);
        transform: translateY(-1px);
    }

    .ai-chat-widget__launcher:active {
        transform: translateY(1px);
    }

    .ai-chat-widget__launcher .material-symbols-outlined {
        font-size: 21px;
    }

    .ai-chat-widget__launcher-close,
    .ai-chat-widget.is-open .ai-chat-widget__launcher-open {
        display: none;
    }

    .ai-chat-widget.is-open .ai-chat-widget__launcher-close {
        display: inline-block;
    }

    .ai-chat-widget.is-open .ai-chat-widget__launcher {
        opacity: 0;
        visibility: hidden;
    }

    .ai-chat-widget__panel {
        position: absolute;
        right: 0;
        bottom: 0;
        display: grid;
        grid-template-rows: auto auto minmax(0, 1fr) auto auto;
        width: min(420px, calc(100vw - 32px));
        height: min(650px, calc(100dvh - 112px));
        overflow: hidden;
        border: 1px solid var(--ai-line);
        border-radius: 14px 14px 0 0;
        background: #fff;
        box-shadow: 0 24px 70px rgba(20, 29, 47, .18);
        opacity: 0;
        transform: translateY(12px) scale(.985);
        transform-origin: bottom right;
        transition: opacity .18s ease, transform .18s ease;
    }

    .ai-chat-widget.is-open .ai-chat-widget__panel {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    .ai-chat-widget__header {
        display: flex;
        min-height: 64px;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px solid var(--ai-line);
        padding: 10px 12px 10px 14px;
        background: #fff;
    }

    .ai-chat-widget__identity {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 10px;
    }

    .ai-chat-widget__mark,
    .ai-chat-widget__welcome-mark {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        background: #fff0eb;
        color: var(--ai-accent);
    }

    .ai-chat-widget__mark {
        width: 38px;
        height: 38px;
        border-radius: 10px;
    }

    .ai-chat-widget__mark .material-symbols-outlined {
        font-size: 22px;
    }

    .ai-chat-widget__title-row {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .ai-chat-widget__title-row h2 {
        margin: 0;
        color: var(--ai-ink);
        font-size: 15px;
        font-weight: 750;
        line-height: 1.3;
    }

    .ai-chat-widget__identity p {
        overflow: hidden;
        margin: 2px 0 0;
        color: var(--ai-muted);
        font-size: 11px;
        line-height: 1.3;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ai-chat-widget__status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22a06b;
        box-shadow: 0 0 0 3px #e3f7ee;
    }

    .ai-chat-widget__header-actions {
        display: flex;
        gap: 2px;
    }

    .ai-chat-widget__header-actions button,
    .ai-chat-widget__history-head button {
        display: inline-flex;
        width: 34px;
        height: 34px;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #667085;
        transition: background-color .15s ease, color .15s ease;
    }

    .ai-chat-widget__header-actions button:hover,
    .ai-chat-widget__history-head button:hover {
        background: #f3f4f6;
        color: var(--ai-ink);
    }

    .ai-chat-widget__header-actions .material-symbols-outlined,
    .ai-chat-widget__history-head .material-symbols-outlined {
        font-size: 19px;
    }

    .ai-chat-widget__messages {
        min-height: 0;
        overflow: auto;
        padding: 18px 14px;
        overscroll-behavior: contain;
        scrollbar-color: #cbd0d8 transparent;
        scrollbar-width: thin;
    }

    .ai-chat-widget__welcome {
        display: flex;
        min-height: 100%;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        padding: 8px 2px 18px;
    }

    .ai-chat-widget__welcome-mark {
        width: 44px;
        height: 44px;
        margin-bottom: 14px;
        border-radius: 12px;
    }

    .ai-chat-widget__welcome h3 {
        margin: 0;
        color: var(--ai-ink);
        font-size: 18px;
        font-weight: 750;
        letter-spacing: -.02em;
    }

    .ai-chat-widget__welcome > p {
        max-width: 36ch;
        margin: 7px 0 18px;
        color: var(--ai-muted);
        font-size: 13px;
        line-height: 1.55;
    }

    .ai-chat-widget__prompts {
        display: grid;
        width: 100%;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .ai-chat-widget__prompts button {
        min-height: 48px;
        border: 1px solid #e2e6ec;
        border-radius: 10px;
        background: #fff;
        color: #344054;
        padding: 9px 10px;
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.35;
        transition: border-color .15s ease, background-color .15s ease;
    }

    .ai-chat-widget__prompts button:hover {
        border-color: #f2aa94;
        background: #fff8f5;
    }

    .ai-chat-message {
        display: flex;
        margin: 0 0 14px;
    }

    .ai-chat-message--user {
        justify-content: flex-end;
    }

    .ai-chat-message__body {
        max-width: 86%;
    }

    .ai-chat-message__text {
        margin: 0;
        border-radius: 12px;
        padding: 10px 12px;
        color: #263043;
        font-size: 13px;
        line-height: 1.55;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .ai-chat-message--assistant .ai-chat-message__text {
        border: 1px solid #e8ebf0;
        border-bottom-left-radius: 4px;
        background: #f7f8fa;
    }

    .ai-chat-message--user .ai-chat-message__text {
        border-bottom-right-radius: 4px;
        background: var(--ai-accent);
        color: #fff;
    }

    .ai-chat-cards {
        display: grid;
        gap: 7px;
        margin-top: 8px;
    }

    .ai-chat-card {
        display: grid;
        grid-template-columns: 46px minmax(0, 1fr) auto;
        align-items: center;
        gap: 9px;
        border: 1px solid #e4e8ee;
        border-radius: 10px;
        background: #fff;
        padding: 7px;
        color: inherit;
        text-decoration: none;
        transition: border-color .15s ease, background-color .15s ease;
    }

    .ai-chat-card:hover {
        border-color: #f2aa94;
        background: #fffaf8;
    }

    .ai-chat-card img,
    .ai-chat-card__icon {
        width: 46px;
        height: 46px;
        border-radius: 7px;
        background: #f2f4f7;
        object-fit: cover;
    }

    .ai-chat-card__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--ai-accent);
    }

    .ai-chat-card strong,
    .ai-chat-card small {
        display: block;
    }

    .ai-chat-card strong {
        overflow: hidden;
        color: #293246;
        font-size: 12px;
        line-height: 1.35;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ai-chat-card small {
        margin-top: 3px;
        color: var(--ai-muted);
        font-size: 11px;
    }

    .ai-chat-card > .material-symbols-outlined {
        color: #98a2b3;
        font-size: 18px;
    }

    .ai-chat-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 8px;
    }

    .ai-chat-actions button,
    .ai-chat-actions a {
        border: 1px solid #ef9a80;
        border-radius: 8px;
        background: #fff;
        color: var(--ai-accent-dark);
        padding: 7px 9px;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
    }

    .ai-chat-widget__thinking {
        display: flex;
        min-height: 30px;
        align-items: center;
        gap: 4px;
        padding: 4px 16px 7px;
        color: var(--ai-muted);
    }

    .ai-chat-widget__thinking span {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--ai-accent);
        animation: ai-chat-pulse 1.1s ease-in-out infinite;
    }

    .ai-chat-widget__thinking span:nth-child(2) {
        animation-delay: .13s;
    }

    .ai-chat-widget__thinking span:nth-child(3) {
        animation-delay: .26s;
    }

    .ai-chat-widget__thinking em {
        margin-left: 5px;
        font-size: 11px;
        font-style: normal;
    }

    .ai-chat-widget__composer {
        border-top: 1px solid var(--ai-line);
        background: #fff;
        padding: 10px 12px 9px;
    }

    .ai-chat-widget__input-wrap {
        display: flex;
        align-items: flex-end;
        gap: 7px;
        border: 1px solid #d8dde5;
        border-radius: 11px;
        background: #fff;
        padding: 7px 7px 7px 11px;
    }

    .ai-chat-widget__input-wrap:focus-within {
        border-color: #ef9a80;
        box-shadow: 0 0 0 3px #fff0eb;
    }

    .ai-chat-widget__input-wrap textarea {
        width: 100%;
        max-height: 104px;
        resize: none;
        border: 0;
        outline: 0;
        background: transparent;
        padding: 4px 0;
        color: var(--ai-ink);
        font-size: 13px;
        line-height: 1.45;
        box-shadow: none;
    }

    .ai-chat-widget__input-wrap textarea:focus {
        border: 0;
        outline: 0;
        box-shadow: none;
        --tw-ring-shadow: 0 0 #0000;
    }

    .ai-chat-widget__input-wrap textarea::placeholder {
        color: #8b95a5;
    }

    .ai-chat-widget__input-wrap button {
        display: inline-flex;
        width: 33px;
        height: 33px;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 8px;
        background: var(--ai-accent);
        color: #fff;
    }

    .ai-chat-widget__input-wrap button:disabled {
        cursor: not-allowed;
        background: #d7dbe2;
    }

    .ai-chat-widget__input-wrap button .material-symbols-outlined {
        font-size: 19px;
    }

    .ai-chat-widget__composer > p {
        margin: 6px 0 0;
        color: #8b95a5;
        font-size: 9.5px;
        text-align: center;
    }

    .ai-chat-widget__error {
        border-bottom: 1px solid #ffd7cc;
        background: #fff4f0;
        color: #9a3412;
        padding: 8px 14px;
        font-size: 11px;
        line-height: 1.4;
    }

    .ai-chat-widget__history {
        position: absolute;
        inset: 64px 0 0;
        z-index: 4;
        background: #fff;
    }

    .ai-chat-widget__history-head {
        display: flex;
        min-height: 48px;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--ai-line);
        padding: 7px 12px 7px 15px;
        color: var(--ai-ink);
        font-size: 13px;
    }

    .ai-chat-widget__history-list {
        height: calc(100% - 48px);
        overflow: auto;
        padding: 7px;
    }

    .ai-chat-history-item {
        display: block;
        width: 100%;
        border: 0;
        border-radius: 8px;
        background: #fff;
        padding: 10px;
        text-align: left;
    }

    .ai-chat-history-item:hover,
    .ai-chat-history-item.is-active {
        background: #fff3ef;
    }

    .ai-chat-history-item strong,
    .ai-chat-history-item small {
        display: block;
    }

    .ai-chat-history-item strong {
        overflow: hidden;
        color: #344054;
        font-size: 12px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ai-chat-history-item small {
        margin-top: 3px;
        color: #8b95a5;
        font-size: 10px;
    }

    .ai-chat-history-empty {
        padding: 34px 15px;
        color: #8b95a5;
        font-size: 12px;
        text-align: center;
    }

    @@keyframes ai-chat-pulse {
        0%, 70%, 100% { opacity: .25; transform: translateY(0); }
        35% { opacity: 1; transform: translateY(-2px); }
    }

    @@media (max-width: 1023.98px) {
        .ai-chat-widget {
            right: 16px;
            bottom: 76px;
        }

        .ai-chat-widget__launcher {
            min-height: 48px;
            border-radius: 9999px;
            padding: 0 16px;
        }

        .ai-chat-widget__overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .32);
        }

        .ai-chat-widget__panel {
            position: fixed;
            inset: auto 0 0;
            width: 100vw;
            height: min(720px, calc(100dvh - 24px));
            border-width: 1px 0 0;
            border-radius: 16px 16px 0 0;
            transform: translateY(100%);
        }

        .ai-chat-widget.is-open .ai-chat-widget__panel {
            transform: translateY(0);
        }
    }

    @@media (max-width: 430px) {
        .ai-chat-widget__prompts {
            grid-template-columns: 1fr;
        }

        .ai-chat-widget__welcome {
            justify-content: flex-start;
            padding-top: 20px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ai-chat-widget__panel,
        .ai-chat-widget__launcher {
            transition: none;
        }

        .ai-chat-widget__thinking span {
            animation: none;
            opacity: .7;
        }
    }
</style>
