@using GearZone.Web.Pages.Shared.Models
@model GearZone.Web.Pages.Public.Catalog.Models.ProductReviewPanelViewModel
@{
    var reviewSummary = Model.ReviewSummary;

    string BuildReviewUrl(int? rating, bool withCommentOnly, int reviewPage = 1)
    {
        var queryParts = new List<string>();
        if (rating.HasValue)
        {
            queryParts.Add($"ReviewRating={rating.Value}");
        }

        if (withCommentOnly)
        {
            queryParts.Add("WithCommentOnly=true");
        }

        if (reviewPage > 1)
        {
            queryParts.Add($"ReviewPage={reviewPage}");
        }

        return queryParts.Count == 0
            ? $"/product/{Model.ProductSlug}"
            : $"/product/{Model.ProductSlug}?{string.Join("&", queryParts)}";
    }

    int GetReviewCountForRating(int rating) =>
        reviewSummary.Breakdown.FirstOrDefault(x => x.Rating == rating)?.Count ?? 0;

    List<int?> BuildPaginationItems()
    {
        var items = new List<int?>();
        var totalPages = Model.ProductReviews.TotalPages;
        var currentPage = Model.ProductReviews.PageNumber;

        if (totalPages <= 7)
        {
            for (var page = 1; page <= totalPages; page++)
            {
                items.Add(page);
            }

            return items;
        }

        items.Add(1);

        var windowStart = Math.Max(2, currentPage - 1);
        var windowEnd = Math.Min(totalPages - 1, currentPage + 1);

        if (currentPage <= 4)
        {
            windowStart = 2;
            windowEnd = 5;
        }
        else if (currentPage >= totalPages - 3)
        {
            windowStart = totalPages - 4;
            windowEnd = totalPages - 1;
        }

        if (windowStart > 2)
        {
            items.Add(null);
        }

        for (var page = windowStart; page <= windowEnd; page++)
        {
            items.Add(page);
        }

        if (windowEnd < totalPages - 1)
        {
            items.Add(null);
        }

        items.Add(totalPages);

        return items;
    }
}

<section id="product-review-panel"
         data-review-panel
         class="review-panel-shell review-section-shell overflow-hidden">
    <div class="review-section-header">
        <div>
            <h2 class="review-section-title">Product Ratings & Reviews</h2>
            <p class="review-section-subtitle">Ratings come from verified buyers only.</p>
        </div>
        @if (Model.EligibleReview != null)
        {
            <a asp-page="/Public/User/WriteReview"
               asp-route-orderItemId="@Model.EligibleReview.OrderItemId"
               class="review-action-link shrink-0">
                @(Model.EligibleReview.HasExistingReview ? "Edit yours" : "Review now")
            </a>
        }
    </div>

    <div class="px-4 pb-4 pt-6 lg:px-8 lg:pb-6">
        <div class="review-summary-band">
            @if (reviewSummary.TotalReviews > 0)
            {
                <div class="grid gap-6 lg:grid-cols-[14rem,1fr] lg:items-center">
                    <div class="text-center lg:text-left">
                        <p class="review-summary-score">
                            <span>@reviewSummary.AverageRating.ToString("0.0")</span> out of 5
                        </p>
                        <div class="mt-3 flex justify-center lg:justify-start">
                            <partial name="/Pages/Shared/_ReviewStars.cshtml"
                                     model='new ReviewStarsViewModel
                                     {
                                         Rating = reviewSummary.AverageRating,
                                         SizePx = 21,
                                         AriaLabel = $"{reviewSummary.AverageRating:0.0} out of 5 stars"
                                     }' />
                        </div>
                        <p class="review-summary-copy">@reviewSummary.TotalReviews rating(s)</p>
                        <p class="review-summary-caption">@reviewSummary.WithCommentCount with written comments</p>
                    </div>

                    <div>
                        <div class="flex flex-wrap gap-2.5">
                            <a href="@BuildReviewUrl(null, false)"
                               data-review-link
                               class="review-chip @(Model.ReviewRating == null && !Model.WithCommentOnly ? "is-active" : string.Empty)">
                                <span>All</span>
                                <span class="review-chip-count">@reviewSummary.TotalReviews</span>
                            </a>
                            @for (var rating = 5; rating >= 1; rating--)
                            {
                                <a href="@BuildReviewUrl(rating, Model.WithCommentOnly)"
                                   data-review-link
                                   class="review-chip @(Model.ReviewRating == rating ? "is-active" : string.Empty)">
                                    <span>@rating Star</span>
                                    <span class="review-chip-count">@GetReviewCountForRating(rating)</span>
                                </a>
                            }
                            <a href="@BuildReviewUrl(Model.ReviewRating, !Model.WithCommentOnly)"
                               data-review-link
                               class="review-chip @(Model.WithCommentOnly ? "is-active" : string.Empty)">
                                <span>With Comment</span>
                                <span class="review-chip-count">@reviewSummary.WithCommentCount</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center">
                    <p class="review-summary-score"><span>0.0</span> out of 5</p>
                    <div class="mt-3 flex justify-center">
                        <partial name="/Pages/Shared/_ReviewStars.cshtml"
                                 model='new ReviewStarsViewModel
                                 {
                                     Rating = 0,
                                     SizePx = 21,
                                     AriaLabel = "No reviews yet"
                                 }' />
                    </div>
                    <p class="review-summary-copy">No verified ratings yet</p>
                    <p class="review-summary-caption">Be the first buyer to review this product after delivery.</p>
                </div>
            }
        </div>

        @if (Model.EligibleReview != null)
        {
            <div class="review-eligible-card mt-4 px-4 py-3.5">
                <div class="flex items-start gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-primary">
                        <span class="material-symbols-outlined text-[19px]">schedule</span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-slate-900">Your verified purchase can be reviewed.</p>
                        <p class="mt-1 text-sm text-slate-500">
                            Window closes @Model.EligibleReview.ReviewDeadline.ToLocalTime().ToString("dd MMM yyyy HH:mm").
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="px-4 lg:px-8">
        @if (Model.ProductReviews.Items.Any())
        {
            @foreach (var review in Model.ProductReviews.Items)
            {
                var avatarInitial = string.IsNullOrWhiteSpace(review.BuyerDisplayName)
                    ? "U"
                    : review.BuyerDisplayName.Substring(0, 1).ToUpperInvariant();

                <article class="review-list-item">
                    <div class="flex gap-4">
                        @if (!string.IsNullOrWhiteSpace(review.BuyerAvatarUrl))
                        {
                            <img src="@review.BuyerAvatarUrl"
                                 alt="@review.BuyerDisplayName"
                                 class="h-10 w-10 rounded-full border border-slate-200 object-cover" />
                        }
                        else
                        {
                            <div class="review-avatar-fallback flex h-10 w-10 items-center justify-center rounded-full text-sm font-semibold">
                                @avatarInitial
                            </div>
                        }

                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <p class="text-sm font-semibold text-slate-900">@review.BuyerDisplayName</p>
                                        <span class="review-user-badge">Verified</span>
                                    </div>
                                    <div class="mt-2">
                                        <partial name="/Pages/Shared/_ReviewStars.cshtml"
                                                 model='new ReviewStarsViewModel
                                                 {
                                                     Rating = review.Rating,
                                                     SizePx = 15,
                                                     AriaLabel = $"{review.Rating} out of 5 stars"
                                                 }' />
                                    </div>
                                    <p class="review-meta-line">
                                        @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                        @if (!string.IsNullOrWhiteSpace(review.VariantName))
                                        {
                                            <span> | Variation: @review.VariantName</span>
                                        }
                                    </p>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-700">@review.Comment</p>
                            }
                            else
                            {
                                <p class="mt-3 text-sm italic text-slate-400">Buyer left a star rating without a written comment.</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(review.SellerReplyContent))
                            {
                                <div class="review-reply-card mt-4 px-4 py-3">
                                    <p class="text-sm font-semibold text-slate-900">Seller response</p>
                                    <p class="mt-1.5 whitespace-pre-line text-sm leading-6 text-slate-600">@review.SellerReplyContent</p>
                                    @if (review.SellerReplyAt.HasValue)
                                    {
                                        <p class="mt-2 text-xs text-slate-400">@review.SellerReplyAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </article>
            }

            @if (Model.ProductReviews.TotalPages > 1)
            {
                var paginationItems = BuildPaginationItems();
                var currentPage = Model.ProductReviews.PageNumber;
                var totalPages = Model.ProductReviews.TotalPages;

                <div class="flex flex-wrap items-center justify-center gap-2 border-t border-[#f5f5f5] py-5">
                    @if (currentPage > 1)
                    {
                        <a href="@BuildReviewUrl(Model.ReviewRating, Model.WithCommentOnly, currentPage - 1)"
                           data-review-link
                           aria-label="Previous review page"
                           class="review-page-link review-page-nav">
                            <span aria-hidden="true">&lsaquo;</span>
                        </a>
                    }
                    else
                    {
                        <span aria-disabled="true" class="review-page-link review-page-nav is-disabled">
                            <span aria-hidden="true">&lsaquo;</span>
                        </span>
                    }

                    @foreach (var pageNumber in paginationItems)
                    {
                        if (pageNumber.HasValue)
                        {
                            <a href="@BuildReviewUrl(Model.ReviewRating, Model.WithCommentOnly, pageNumber.Value)"
                               data-review-link
                               class="review-page-link @(pageNumber.Value == currentPage ? "is-active" : string.Empty)">
                                @pageNumber.Value
                            </a>
                        }
                        else
                        {
                            <span class="review-page-ellipsis" aria-hidden="true">...</span>
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        <a href="@BuildReviewUrl(Model.ReviewRating, Model.WithCommentOnly, currentPage + 1)"
                           data-review-link
                           aria-label="Next review page"
                           class="review-page-link review-page-nav">
                            <span aria-hidden="true">&rsaquo;</span>
                        </a>
                    }
                    else
                    {
                        <span aria-disabled="true" class="review-page-link review-page-nav is-disabled">
                            <span aria-hidden="true">&rsaquo;</span>
                        </span>
                    }
                </div>
            }
        }
        else
        {
            <div class="review-soft-panel mb-6 px-5 py-8 text-center">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-white text-slate-300">
                    <span class="material-symbols-outlined text-3xl">forum</span>
                </div>
                <p class="mt-4 text-sm font-semibold text-slate-700">No reviews match this filter</p>
                <p class="mt-2 text-xs text-slate-400">Try another star filter or switch off the comment-only filter.</p>
            </div>
        }
    </div>
</section>
