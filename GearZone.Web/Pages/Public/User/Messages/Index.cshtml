@page "/messages"
@model GearZone.Web.Pages.Public.User.Messages.IndexModel
@{
    ViewData["Title"] = "Messages - GearZone";
}

<div class="mx-auto w-full max-w-[1380px] px-4 py-6 lg:px-8">
    <div class="mb-5">
        <p class="text-[11px] font-black uppercase tracking-[0.22em] text-orange-500">Shopee-close Chat</p>
        <h1 class="mt-2 text-[28px] font-bold text-slate-900">Messages</h1>
        <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-500">Keep every shop conversation inside one realtime inbox that feels compact and smooth.</p>
    </div>

    <partial name="/Pages/Shared/_ChatInboxLayout.cshtml" model="Model.Inbox" />
</div>

@section Styles {
    <partial name="/Pages/Shared/_ChatInboxStyles.cshtml" />
}

@section Scripts {
    <partial name="/Pages/Shared/_ChatInboxScripts.cshtml" />
}
