@page "/orders/track/{subOrderId:guid}"
@using GearZone.Domain.Enums
@using System.Collections.Generic
@model GearZone.Web.Pages.Public.User.Orders.TrackModel
@{
    ViewData["Title"] = $"Track Order #{Model.Tracking.OrderCode}";

    string GetBadgeClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-amber-50 text-amber-700 border border-amber-200",
        OrderStatus.AwaitingPayment => "bg-orange-50 text-orange-700 border border-orange-200",
        OrderStatus.Approved => "bg-sky-50 text-sky-700 border border-sky-200",
        OrderStatus.Paid => "bg-indigo-50 text-indigo-700 border border-indigo-200",
        OrderStatus.Processing => "bg-blue-50 text-blue-700 border border-blue-200",
        OrderStatus.Delivered => "bg-emerald-50 text-emerald-700 border border-emerald-200",
        OrderStatus.Completed => "bg-emerald-100 text-emerald-800 border border-emerald-300",
        OrderStatus.Cancelled => "bg-rose-50 text-rose-700 border border-rose-200",
        OrderStatus.Rejected => "bg-red-50 text-red-700 border border-red-200",
        OrderStatus.Refunded => "bg-orange-50 text-orange-700 border border-orange-200",
        _ => "bg-gray-50 text-gray-700 border border-gray-200"
    };

    var statusIcons = new Dictionary<OrderStatus, string>
    {
        { OrderStatus.Pending, "pending" },
        { OrderStatus.AwaitingPayment, "payments" },
        { OrderStatus.Approved, "verified" },
        { OrderStatus.Rejected, "block" },
        { OrderStatus.Paid, "paid" },
        { OrderStatus.Processing, "package_2" },
        { OrderStatus.Delivered, "local_shipping" },
        { OrderStatus.Cancelled, "do_not_disturb_on" },
        { OrderStatus.Completed, "task_alt" },
        { OrderStatus.Refunded, "keyboard_return" }
    };
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <a asp-page="/Public/User/Profile"
           asp-route-tab="orders"
           class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-[0.14em] text-slate-700 transition hover:bg-slate-50">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            Back to Orders
        </a>
        <a href="/store/@Model.Tracking.StoreSlug"
           class="inline-flex items-center gap-2 rounded-full border border-orange-200 bg-orange-50 px-4 py-2 text-xs font-black uppercase tracking-[0.14em] text-orange-600 transition hover:bg-orange-100">
            <span class="material-symbols-outlined text-[16px]">storefront</span>
            @Model.Tracking.StoreName
        </a>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <p class="text-[11px] font-black uppercase tracking-[0.22em] text-primary">Order Tracking</p>
                <h1 class="mt-2 text-2xl font-black text-slate-900">#@Model.Tracking.OrderCode</h1>
                <p class="mt-1 text-sm text-slate-500">Placed @Model.Tracking.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
            </div>
            <span id="tracking-current-status" class="inline-flex items-center rounded-full px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] @GetBadgeClass(Model.Tracking.Status)">
                @Model.Tracking.Status
            </span>
        </div>

        <div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-3">
            <div class="rounded-xl border border-slate-100 bg-slate-50 p-3">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Subtotal</p>
                <p class="mt-1 text-sm font-bold text-slate-900">@Model.Tracking.Subtotal.ToString("N0") VND</p>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50 p-3">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Shipping</p>
                <p class="mt-1 text-sm font-bold text-slate-900">@Model.Tracking.ShippingFee.ToString("N0") VND</p>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50 p-3">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Grand Total</p>
                <p class="mt-1 text-sm font-black text-primary">@Model.Tracking.GrandTotal.ToString("N0") VND</p>
            </div>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-6 xl:grid-cols-3">
        <div class="overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm xl:col-span-2">
            <div class="flex items-center justify-between border-b border-slate-50 p-6">
                <div class="flex items-center gap-3">
                    <div class="flex size-10 items-center justify-center rounded-xl bg-slate-900 text-white shadow-lg">
                        <span class="material-symbols-outlined text-lg">history</span>
                    </div>
                    <h2 class="text-lg font-bold text-slate-900">Order Tracking Activity</h2>
                </div>
                <span class="rounded-lg bg-slate-100 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-slate-500">Real-time History</span>
            </div>

            <div class="p-6">
                <div id="status-timeline-empty" class="@(Model.Tracking.StatusHistory.Any() ? "hidden " : "")flex flex-col items-center justify-center gap-3 rounded-3xl border-2 border-dashed border-slate-100 py-12 text-slate-400">
                    <span class="material-symbols-outlined text-4xl opacity-20">history_toggle_off</span>
                    <p class="text-sm font-bold uppercase tracking-widest opacity-40">No activity recorded yet</p>
                </div>

                <div id="status-timeline-list" class="@(Model.Tracking.StatusHistory.Any() ? "" : "hidden ")relative space-y-8 before:absolute before:left-[19px] before:top-0 before:h-full before:w-1 before:bg-gradient-to-b before:from-primary before:via-blue-300 before:to-transparent">
                    @foreach (var history in Model.Tracking.StatusHistory.OrderByDescending(x => x.ChangedAt))
                    {
                        var icon = statusIcons.ContainsKey(history.NewStatus) ? statusIcons[history.NewStatus] : "check_circle";
                        <div class="group relative flex items-start gap-6">
                            <div class="z-10 rounded-full border-4 border-slate-50 bg-white p-1">
                                <div class="flex size-7 items-center justify-center rounded-full border-2 border-primary bg-white shadow-sm">
                                    <span class="material-symbols-outlined text-[14px] font-black text-primary">@icon</span>
                                </div>
                            </div>
                            <div class="-mt-1 flex-1 rounded-2xl border border-slate-100 bg-slate-50/50 p-4 transition-all hover:border-primary/20 hover:bg-white hover:shadow-md">
                                <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                                    <h3 class="text-sm font-black uppercase tracking-wider text-slate-900">@history.NewStatus</h3>
                                    <span class="flex items-center gap-1.5 text-[10px] font-bold text-slate-400">
                                        <span class="material-symbols-outlined text-[10px]">calendar_month</span>
                                        @history.ChangedAt.ToLocalTime().ToString("MMM dd, yyyy - HH:mm")
                                    </span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(history.Note))
                                {
                                    <div class="relative">
                                        <span class="absolute left-0 top-0 text-2xl leading-none text-slate-200">"</span>
                                        <p class="px-4 text-sm italic text-slate-500">@history.Note</p>
                                    </div>
                                }

                                <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-slate-100/50 pt-3">
                                    <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Modified From</span>
                                    <span class="rounded bg-slate-100 px-2 py-0.5 text-[10px] font-black text-slate-500">@(history.OldStatus?.ToString() ?? "-")</span>
                                    <span class="text-[10px] font-semibold text-slate-400">By</span>
                                    <span class="text-xs font-semibold text-slate-600">@history.ChangedByDisplayName</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm">
                <div class="flex items-center gap-3 border-b border-slate-50 p-6">
                    <div class="flex size-8 items-center justify-center rounded-lg bg-blue-50 text-primary">
                        <span class="material-symbols-outlined text-lg">local_shipping</span>
                    </div>
                    <h2 class="font-bold text-slate-800">Logistic Details</h2>
                </div>
                <div class="space-y-6 p-6">
                    <div>
                        <p class="mb-3 text-[10px] font-black uppercase tracking-widest text-slate-400">Recipient</p>
                        <div class="flex items-center gap-3">
                            <div class="flex size-10 items-center justify-center rounded-full bg-slate-100 font-bold text-slate-500">
                                @(string.IsNullOrWhiteSpace(Model.Tracking.ReceiverName) ? "?" : Model.Tracking.ReceiverName.Substring(0, 1))
                            </div>
                            <div>
                                <p id="shipping-receiver-value" class="leading-none text-sm font-black text-slate-900">@Model.Tracking.ReceiverName</p>
                                <p id="shipping-phone-value" class="mt-1 text-xs text-slate-500">@Model.Tracking.ReceiverPhone</p>
                            </div>
                        </div>
                    </div>

                    <div>
                        <p class="mb-3 text-[10px] font-black uppercase tracking-widest text-slate-400">Destination Address</p>
                        <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4 text-sm font-medium leading-relaxed text-slate-700 shadow-inner" id="shipping-address-value">
                            @Model.Tracking.ShippingAddress
                        </div>
                    </div>

                    <div class="space-y-3 pt-1">
                        <div id="shipping-provider-row" class="@(string.IsNullOrWhiteSpace(Model.Tracking.ShippingProvider) ? "hidden " : "")flex items-center justify-between">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Shipping Agent</p>
                            <span id="shipping-provider-value" class="text-xs font-bold text-slate-900">@Model.Tracking.ShippingProvider</span>
                        </div>

                        <div id="shipping-tracking-row" class="@(string.IsNullOrWhiteSpace(Model.Tracking.TrackingNumber) ? "hidden " : "")flex items-center justify-between gap-2">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Waybill</p>
                            <code id="shipping-tracking-value" class="rounded-lg border border-primary/10 bg-primary/5 px-3 py-1.5 font-mono text-[11px] font-bold text-primary">@Model.Tracking.TrackingNumber</code>
                        </div>

                        <div id="shipping-delivered-row" class="@(Model.Tracking.DeliveredAt.HasValue ? "" : "hidden ")flex items-center justify-between">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Delivered At</p>
                            <span id="shipping-delivered-value" class="text-xs font-bold text-emerald-700">@(Model.Tracking.DeliveredAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm"))</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-black uppercase tracking-[0.14em] text-slate-500">Order Items</h2>
        <div class="mt-4 space-y-3">
            @foreach (var item in Model.Tracking.Items)
            {
                <div class="flex flex-col gap-3 rounded-xl border border-slate-100 bg-slate-50 p-3 md:flex-row md:items-center md:justify-between">
                    <div class="flex items-center gap-3">
                        <a href="/product/@item.ProductSlug" class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-lg border border-slate-100 bg-white">
                            <img src="@(string.IsNullOrWhiteSpace(item.ProductImageUrl) ? "/images/placeholder.png" : item.ProductImageUrl)"
                                 alt="@item.ProductName"
                                 class="h-full w-full object-contain p-1" />
                        </a>
                        <div>
                            <a href="/product/@item.ProductSlug" class="text-sm font-semibold text-slate-900 hover:text-primary">@item.ProductName</a>
                            <p class="text-xs text-slate-500">@(!string.IsNullOrWhiteSpace(item.VariantName) ? item.VariantName : "Default")</p>
                            <p class="text-xs text-slate-500">x@item.Quantity</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-sm font-semibold text-slate-700">@item.UnitPrice.ToString("N0") VND</p>
                        <p class="text-sm font-black text-slate-900">@item.LineTotal.ToString("N0") VND</p>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        (function () {
            const subOrderId = '@Model.Tracking.SubOrderId';
            const statusBadgeEl = document.getElementById('tracking-current-status');
            const timelineListEl = document.getElementById('status-timeline-list');
            const timelineEmptyEl = document.getElementById('status-timeline-empty');
            const shippingProviderRowEl = document.getElementById('shipping-provider-row');
            const shippingProviderValueEl = document.getElementById('shipping-provider-value');
            const shippingTrackingRowEl = document.getElementById('shipping-tracking-row');
            const shippingTrackingValueEl = document.getElementById('shipping-tracking-value');
            const shippingDeliveredRowEl = document.getElementById('shipping-delivered-row');
            const shippingDeliveredValueEl = document.getElementById('shipping-delivered-value');

            if (!statusBadgeEl || !timelineListEl || !timelineEmptyEl) {
                return;
            }

            const liveUrlBase = '@Url.Page("/Public/User/Orders/Track", "Live", new { subOrderId = Model.Tracking.SubOrderId })';
            const hubUrl = '/hubs/order-tracking';

            const statusClassMap = {
                Pending: 'bg-amber-50 text-amber-700 border border-amber-200',
                AwaitingPayment: 'bg-orange-50 text-orange-700 border border-orange-200',
                Approved: 'bg-sky-50 text-sky-700 border border-sky-200',
                Paid: 'bg-indigo-50 text-indigo-700 border border-indigo-200',
                Processing: 'bg-blue-50 text-blue-700 border border-blue-200',
                Delivered: 'bg-emerald-50 text-emerald-700 border border-emerald-200',
                Completed: 'bg-emerald-100 text-emerald-800 border border-emerald-300',
                Cancelled: 'bg-rose-50 text-rose-700 border border-rose-200',
                Rejected: 'bg-red-50 text-red-700 border border-red-200',
                Refunded: 'bg-orange-50 text-orange-700 border border-orange-200'
            };

            const statusIconMap = {
                Pending: 'pending',
                AwaitingPayment: 'payments',
                Approved: 'verified',
                Rejected: 'block',
                Paid: 'paid',
                Processing: 'package_2',
                Delivered: 'local_shipping',
                Cancelled: 'do_not_disturb_on',
                Completed: 'task_alt',
                Refunded: 'keyboard_return'
            };

            const badgeBaseClass = 'inline-flex items-center rounded-full px-3 py-1 text-xs font-bold uppercase tracking-[0.14em]';
            let trackingConnection = null;
            let inFlight = false;

            function getStatusBadgeClass(status) {
                return statusClassMap[status] || 'bg-gray-50 text-gray-700 border border-gray-200';
            }

            function getStatusIcon(status) {
                return statusIconMap[status] || 'check_circle';
            }

            function escapeHtml(input) {
                if (input === null || input === undefined) {
                    return '';
                }

                return String(input)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function formatDateTime(isoString) {
                if (!isoString) {
                    return '-';
                }

                const date = new Date(isoString);
                if (Number.isNaN(date.getTime())) {
                    return '-';
                }

                return date.toLocaleString('en-GB', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false
                });
            }

            function toggleRow(rowEl, shouldShow) {
                if (!rowEl) {
                    return;
                }

                rowEl.classList.toggle('hidden', !shouldShow);
            }

            function renderTimeline(statusHistory) {
                if (!Array.isArray(statusHistory) || statusHistory.length === 0) {
                    timelineListEl.innerHTML = '';
                    timelineListEl.classList.add('hidden');
                    timelineEmptyEl.classList.remove('hidden');
                    return;
                }

                const cardsHtml = statusHistory.map((history) => {
                    const fromStatus = history.oldStatus ? escapeHtml(history.oldStatus) : '-';
                    const changedBy = escapeHtml(history.changedByDisplayName || 'System');
                    const statusText = escapeHtml(history.newStatus || '-');
                    const statusIcon = getStatusIcon(history.newStatus);
                    const changedAtText = formatDateTime(history.changedAtIso);
                    const noteHtml = history.note
                        ? `<div class="relative"><span class="absolute left-0 top-0 text-2xl leading-none text-slate-200">"</span><p class="px-4 text-sm italic text-slate-500">${escapeHtml(history.note)}</p></div>`
                        : '';

                    return `
                        <div class="group relative flex items-start gap-6">
                            <div class="z-10 rounded-full border-4 border-slate-50 bg-white p-1">
                                <div class="flex size-7 items-center justify-center rounded-full border-2 border-primary bg-white shadow-sm">
                                    <span class="material-symbols-outlined text-[14px] font-black text-primary">${statusIcon}</span>
                                </div>
                            </div>
                            <div class="-mt-1 flex-1 rounded-2xl border border-slate-100 bg-slate-50/50 p-4 transition-all hover:border-primary/20 hover:bg-white hover:shadow-md">
                                <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                                    <h3 class="text-sm font-black uppercase tracking-wider text-slate-900">${statusText}</h3>
                                    <span class="flex items-center gap-1.5 text-[10px] font-bold text-slate-400">
                                        <span class="material-symbols-outlined text-[10px]">calendar_month</span>
                                        ${changedAtText}
                                    </span>
                                </div>
                                ${noteHtml}
                                <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-slate-100/50 pt-3">
                                    <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Modified From</span>
                                    <span class="rounded bg-slate-100 px-2 py-0.5 text-[10px] font-black text-slate-500">${fromStatus}</span>
                                    <span class="text-[10px] font-semibold text-slate-400">By</span>
                                    <span class="text-xs font-semibold text-slate-600">${changedBy}</span>
                                </div>
                            </div>
                        </div>`;
                }).join('');

                timelineListEl.innerHTML = cardsHtml;
                timelineListEl.classList.remove('hidden');
                timelineEmptyEl.classList.add('hidden');
            }

            function applyTrackingPayload(payload) {
                if (!payload) {
                    return;
                }

                const latestStatus = payload.status || 'Unknown';
                statusBadgeEl.className = `${badgeBaseClass} ${getStatusBadgeClass(latestStatus)}`;
                statusBadgeEl.textContent = latestStatus;

                toggleRow(shippingProviderRowEl, !!payload.shippingProvider);
                if (shippingProviderValueEl) {
                    shippingProviderValueEl.textContent = payload.shippingProvider || '';
                }

                toggleRow(shippingTrackingRowEl, !!payload.trackingNumber);
                if (shippingTrackingValueEl) {
                    shippingTrackingValueEl.textContent = payload.trackingNumber || '';
                }

                toggleRow(shippingDeliveredRowEl, !!payload.deliveredAtIso);
                if (shippingDeliveredValueEl) {
                    shippingDeliveredValueEl.textContent = payload.deliveredAtIso ? formatDateTime(payload.deliveredAtIso) : '';
                }

                renderTimeline(payload.statusHistory || []);
            }

            async function fetchLiveTracking() {
                if (inFlight) {
                    return;
                }

                inFlight = true;
                try {
                    const separator = liveUrlBase.includes('?') ? '&' : '?';
                    const response = await fetch(`${liveUrlBase}${separator}_=${Date.now()}`, {
                        method: 'GET',
                        cache: 'no-store',
                        headers: {
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!response.ok) {
                        return;
                    }

                    const payload = await response.json();
                    applyTrackingPayload(payload);
                } catch (_) {
                    // Ignore transient polling errors.
                } finally {
                    inFlight = false;
                }
            }

            async function tryConnectRealtime() {
                if (!window.signalR || !subOrderId) {
                    return;
                }

                trackingConnection = new signalR.HubConnectionBuilder()
                    .withUrl(hubUrl)
                    .withAutomaticReconnect([0, 2000, 5000, 10000])
                    .build();

                trackingConnection.on('TrackingUpdated', function (payload) {
                    if (!payload || !payload.subOrderId) {
                        return;
                    }

                    if (String(payload.subOrderId).toLowerCase() !== String(subOrderId).toLowerCase()) {
                        return;
                    }

                    fetchLiveTracking();
                });

                trackingConnection.onreconnected(async function () {
                    try {
                        await trackingConnection.invoke('JoinTracking', subOrderId);
                        fetchLiveTracking();
                    } catch (_) {
                        // Polling still keeps UI updated when rejoin fails.
                    }
                });

                try {
                    await trackingConnection.start();
                    await trackingConnection.invoke('JoinTracking', subOrderId);
                } catch (_) {
                    // Polling fallback continues to work.
                }
            }

            const pollingIntervalMs = 3000;
            fetchLiveTracking();
            window.setInterval(fetchLiveTracking, pollingIntervalMs);
            tryConnectRealtime();

            document.addEventListener('visibilitychange', function () {
                if (!document.hidden) {
                    fetchLiveTracking();
                }
            });

            window.addEventListener('beforeunload', function () {
                if (trackingConnection) {
                    trackingConnection.stop();
                }
            });
        })();
    </script>
}
