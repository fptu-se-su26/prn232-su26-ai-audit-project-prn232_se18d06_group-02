@page
@model GearZone.Web.Pages.IndexModel
@using System
@using System.Linq
@{
    ViewData["Title"] = "Gaming hardware marketplace";
    ViewData["Description"] = "Shop gaming hardware from verified stores, discover fresh arrivals, and compare the latest setup gear on GearZone.";
    ViewData["BodyClass"] = "gearzone-home-page";

    var heroSlides = Model.HeroSlides.Take(3).ToList();
    var serviceItems = Model.ServiceItems.Take(4).ToList();
    var categories = Model.HomePage.Categories.Take(6).ToList();
    var freshProducts = Model.HomePage.FlashRail.Products
        .Where(product => !string.IsNullOrWhiteSpace(product.ImageUrl))
        .Take(5)
        .ToList();
    var discoveryProducts = Model.HomePage.RecommendedRail.Products
        .Where(product => !string.IsNullOrWhiteSpace(product.ImageUrl))
        .Take(5)
        .ToList();
    var featuredStore = Model.HomePage.Stores.FirstOrDefault();
    var categoryMedia = Model.HomePage.HeroProducts
        .Concat(freshProducts)
        .Concat(discoveryProducts)
        .Where(product => !string.IsNullOrWhiteSpace(product.ImageUrl))
        .GroupBy(product => product.Id)
        .Select(group => group.First())
        .ToList();

    string GetCategoryImage(int index)
        => categoryMedia.Count > 0
            ? categoryMedia[index % categoryMedia.Count].ImageUrl
            : string.Empty;

    var storeVisual = discoveryProducts
        .Concat(freshProducts)
        .FirstOrDefault(product => !string.IsNullOrWhiteSpace(product.ImageUrl))?.ImageUrl
        ?? string.Empty;
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:opsz,wght@@8..60,300;8..60,400;8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <script>document.documentElement.classList.add('gz-home-js');</script>
}

<div class="gz-home" id="home-content">
    <section class="gz-hero"
             data-home-carousel
             aria-label="GearZone advertising campaigns"
             aria-roledescription="carousel">
        <div class="gz-hero__slides" aria-live="off">
            @for (var index = 0; index < heroSlides.Count; index++)
            {
                var slide = heroSlides[index];
                <article class="gz-hero__slide @(index == 0 ? "is-active" : string.Empty)"
                         data-carousel-slide
                         aria-hidden="@(index == 0 ? "false" : "true")">
                    <div class="gz-hero__media gz-hero__media--product">
                        <img src="@slide.ImageUrl"
                             alt="@slide.ImageAlt"
                             loading="@(index == 0 ? "eager" : "lazy")"
                             fetchpriority="@(index == 0 ? "high" : "auto")"
                             decoding="async" />
                    </div>
                    <div class="gz-hero__scrim" aria-hidden="true"></div>
                    <div class="gz-shell gz-hero__content">
                        <div class="gz-hero__copy">
                            <p class="gz-hero__eyebrow">@slide.Eyebrow</p>
                            @if (index == 0)
                            {
                                <h1 class="gz-hero__title">@slide.Title</h1>
                            }
                            else
                            {
                                <h2 class="gz-hero__title">@slide.Title</h2>
                            }
                            <p class="gz-hero__description">@slide.Description</p>
                            <div class="gz-hero__actions">
                                <a href="@slide.PrimaryHref" class="gz-button gz-button--primary">@slide.PrimaryLabel</a>
                                <a href="@slide.SecondaryHref" class="gz-button gz-button--secondary">@slide.SecondaryLabel</a>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>

        @if (heroSlides.Count > 1)
        {
            <div class="gz-hero__controls">
                <div class="gz-shell gz-hero__controls-inner">
                    <div class="gz-hero__indicators" aria-label="Choose advertising campaign">
                        @for (var index = 0; index < heroSlides.Count; index++)
                        {
                            <button type="button"
                                    class="gz-hero__indicator @(index == 0 ? "is-active" : string.Empty)"
                                    data-carousel-indicator
                                    data-slide-index="@index"
                                    aria-current="@(index == 0 ? "true" : "false")"
                                    aria-label="Show campaign @(index + 1)"></button>
                        }
                    </div>
                    <div class="gz-hero__control-group">
                        <button type="button" class="gz-hero__control" data-carousel-pause aria-label="Pause carousel">
                            <span class="material-symbols-outlined" aria-hidden="true">pause</span>
                        </button>
                        <button type="button" class="gz-hero__control" data-carousel-prev aria-label="Previous campaign">
                            <span class="material-symbols-outlined" aria-hidden="true">west</span>
                        </button>
                        <button type="button" class="gz-hero__control" data-carousel-next aria-label="Next campaign">
                            <span class="material-symbols-outlined" aria-hidden="true">east</span>
                        </button>
                    </div>
                </div>
            </div>
        }
    </section>

    @if (serviceItems.Any())
    {
        <section class="gz-trust" aria-label="Marketplace services">
            <div class="gz-shell gz-trust__grid">
                @foreach (var item in serviceItems)
                {
                    <a href="@item.Href" class="gz-trust__item">
                        <span class="gz-trust__icon" aria-hidden="true">
                            <span class="material-symbols-outlined">@item.Icon</span>
                        </span>
                        <span>
                            <span class="gz-trust__title">@item.Title</span>
                            <span class="gz-trust__subtitle">@item.Subtitle</span>
                        </span>
                    </a>
                }
            </div>
        </section>
    }

    @if (categories.Any())
    {
        <section class="gz-section gz-section--light" aria-labelledby="category-heading">
            <div class="gz-shell" data-home-reveal>
                <div class="gz-section-header">
                    <div class="gz-section-header__copy">
                        <h2 class="gz-section-heading" id="category-heading">Find your next upgrade</h2>
                        <p class="gz-section-copy">Browse the hardware categories that shape a complete gaming setup.</p>
                    </div>
                    <a href="/products" class="gz-text-link">
                        View all
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                    </a>
                </div>

                <div class="gz-category-grid">
                    @for (var index = 0; index < categories.Count; index++)
                    {
                        var category = categories[index];
                        var categoryImage = GetCategoryImage(index);
                        <a href="@category.Href" class="gz-category-card @(index == 0 ? "gz-category-card--featured" : string.Empty)">
                            <span class="gz-category-card__media">
                                @if (!string.IsNullOrWhiteSpace(categoryImage))
                                {
                                    <img src="@categoryImage"
                                         alt=""
                                         loading="lazy"
                                         decoding="async" />
                                }
                            </span>
                            <span class="gz-category-card__body">
                                <span class="gz-category-card__name">@category.Name</span>
                                <span class="gz-category-card__count">@category.ProductCount products</span>
                            </span>
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    <section class="gz-section gz-section--fresh" id="home-flash-zone" aria-labelledby="fresh-heading">
        <div class="gz-shell" data-home-reveal>
            <div class="gz-section-header">
                <div class="gz-section-header__copy">
                    <h2 class="gz-section-heading" id="fresh-heading">Fresh arrivals</h2>
                    <p class="gz-section-copy">Recently updated hardware from active stores.</p>
                </div>
                <a href="@Model.HomePage.FlashRail.ViewAllHref" class="gz-text-link">
                    View all
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
            </div>

            @if (freshProducts.Any())
            {
                <div class="gz-product-rail" aria-label="Fresh product arrivals">
                    @foreach (var product in freshProducts)
                    {
                        <article class="gz-rail-card">
                            <a href="/product/@product.Slug" class="gz-rail-card__media">
                                <img src="@product.ImageUrl"
                                     alt="@product.Name"
                                     loading="lazy"
                                     decoding="async" />
                            </a>
                            <div class="gz-rail-card__body">
                                <p class="gz-rail-card__store">@product.StoreName</p>
                                <h3 class="gz-rail-card__title">
                                    <a href="/product/@product.Slug">@product.Name</a>
                                </h3>
                                <div class="gz-rail-card__price-row">
                                    <span class="gz-rail-card__price">@product.BasePrice.ToString("N0") VND</span>
                                    @if (product.OriginalPrice.HasValue)
                                    {
                                        <span class="gz-rail-card__old-price">@product.OriginalPrice.Value.ToString("N0") VND</span>
                                    }
                                </div>
                                <button type="button"
                                        class="gz-button gz-button--commerce gz-rail-card__action add-to-cart-grid-btn"
                                        data-variant-id="@product.DefaultVariantId"
                                        @(product.IsInStock ? string.Empty : "disabled")>
                                    @(product.IsInStock ? "Add to cart" : "Out of stock")
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="gz-empty">
                    <p>No fresh products are available right now.</p>
                    <a href="/products" class="gz-text-link">Browse the catalog</a>
                </div>
            }
        </div>
    </section>

    @if (featuredStore != null)
    {
        <section class="gz-section gz-section--light" aria-labelledby="store-heading">
            <div class="gz-shell" data-home-reveal>
                <div class="gz-section-header">
                    <div class="gz-section-header__copy">
                        <h2 class="gz-section-heading" id="store-heading">Verified stores</h2>
                        <p class="gz-section-copy">Shop from active sellers with real catalog and sales data.</p>
                    </div>
                </div>

                <article class="gz-store-showcase">
                    <a href="@featuredStore.Href" class="gz-store-showcase__media" aria-label="Visit @featuredStore.StoreName">
                        @if (!string.IsNullOrWhiteSpace(storeVisual))
                        {
                            <img src="@storeVisual" alt="Featured hardware from @featuredStore.StoreName" loading="lazy" decoding="async" />
                        }
                    </a>
                    <div class="gz-store-showcase__content">
                        <span class="gz-store-showcase__logo">
                            @if (!string.IsNullOrWhiteSpace(featuredStore.LogoUrl))
                            {
                                <img src="@featuredStore.LogoUrl" alt="@featuredStore.StoreName logo" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                @(string.IsNullOrWhiteSpace(featuredStore.StoreName) ? "G" : featuredStore.StoreName[0].ToString())
                            }
                        </span>
                        <h3 class="gz-store-showcase__title">@featuredStore.StoreName</h3>
                        <p class="gz-store-showcase__description">
                            @(string.IsNullOrWhiteSpace(featuredStore.Description)
                                ? "Explore current hardware, contact the store, and shop through verified product routes."
                                : featuredStore.Description)
                        </p>
                        <div class="gz-store-metrics" aria-label="Store summary">
                            <div class="gz-store-metric">
                                <span class="gz-store-metric__value">@featuredStore.Rating.ToString("0.0")</span>
                                <span class="gz-store-metric__label">Rating</span>
                            </div>
                            <div class="gz-store-metric">
                                <span class="gz-store-metric__value">@featuredStore.ProductCount.ToString("N0")</span>
                                <span class="gz-store-metric__label">Products</span>
                            </div>
                            <div class="gz-store-metric">
                                <span class="gz-store-metric__value">@featuredStore.TotalSold.ToString("N0")</span>
                                <span class="gz-store-metric__label">Sold</span>
                            </div>
                        </div>
                        <a href="@featuredStore.Href" class="gz-button gz-button--primary">Visit store</a>
                    </div>
                </article>
            </div>
        </section>
    }

    <section class="gz-section gz-section--soft" aria-labelledby="discovery-heading">
        <div class="gz-shell" data-home-reveal>
            <div class="gz-section-header">
                <div class="gz-section-header__copy">
                    <h2 class="gz-section-heading" id="discovery-heading">More to explore</h2>
                </div>
                <a href="@Model.HomePage.RecommendedRail.ViewAllHref" class="gz-text-link">
                    View all products
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
            </div>

            @if (discoveryProducts.Any())
            {
                <div class="gz-discovery-grid">
                    @foreach (var product in discoveryProducts)
                    {
                        <article class="gz-discovery-card">
                            <a href="/product/@product.Slug" class="gz-discovery-card__link">
                                <span class="gz-discovery-card__media">
                                    <img src="@product.ImageUrl"
                                         alt="@product.Name"
                                         loading="lazy"
                                         decoding="async" />
                                </span>
                                <span class="gz-discovery-card__body">
                                    <span class="gz-discovery-card__title">@product.Name</span>
                                    <span class="gz-discovery-card__store">@product.StoreName</span>
                                    <span class="gz-discovery-card__price">@product.BasePrice.ToString("N0") VND</span>
                                </span>
                            </a>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="gz-empty">
                    <p>No recommended products are available right now.</p>
                    <a href="/products" class="gz-text-link">Browse the catalog</a>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
