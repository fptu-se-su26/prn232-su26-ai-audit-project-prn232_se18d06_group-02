@page "/admin/orders/{id:guid}"
@model GearZone.Web.Pages.Admin.Orders.DetailModel
@using GearZone.Domain.Enums
@using System.Collections.Generic
@{
    ViewData["Title"] = $"Order #{Model.Order.OrderCode} Details";
    ViewData["PageHeader"] = $"Order #{Model.Order.OrderCode}";
    ViewData["ActivePage"] = "Orders";
    ViewData["Breadcrumb"] = new string[] { "Dashboard", "Orders", $"#{Model.Order.OrderCode}" };
    Layout = "_AdminLayout";
}

<!-- Custom style from prototype -->
<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #334155;
        border-radius: 10px;
    }
</style>

<!-- Status and Actions Bar -->
<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-8">
    <div class="flex items-center gap-3 flex-wrap">
        @if (Model.Order.PaidAt.HasValue)
        {
            <span class="px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-sm border border-emerald-200/50">
                <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span> PAID
            </span>
        }
        else
        {
            <span class="px-3 py-1 bg-amber-100 text-amber-700 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-sm border border-amber-200/50">
                <span class="w-2 h-2 bg-amber-500 rounded-full"></span> UNPAID
            </span>
        }
        
        @{
            var allDelivered = Model.Order.SubOrders.All(s => s.Status == OrderStatus.Delivered);
            var anyCancelled = Model.Order.SubOrders.Any(s => s.Status == OrderStatus.Cancelled);
        }
        @if (allDelivered)
        {
            <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-sm border border-blue-200/50">
                <span class="w-2 h-2 bg-blue-500 rounded-full"></span> FULLY DELIVERED
            </span>
        }
        else if (anyCancelled)
        {
            <span class="px-3 py-1 bg-red-100 text-red-700 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-sm border border-red-200/50">
                <span class="w-2 h-2 bg-red-500 rounded-full"></span> ATTENTION REQUIRED
            </span>
        }
        else 
        {
            <span class="px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-sm border border-slate-200/50">
                <span class="w-2 h-2 bg-slate-400 rounded-full"></span> PROCESSING
            </span>
        }
    </div>
    
    <div class="flex items-center gap-3">
        <button class="flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 text-slate-700 rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-all font-bold text-sm shadow-sm">
            <span class="material-symbols-outlined text-lg">print</span>
            <span>Print Invoice</span>
        </button>
        <button class="flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 text-slate-700 rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-all font-bold text-sm shadow-sm">
            <span class="material-symbols-outlined text-lg">download</span>
            <span>Export PDF</span>
        </button>
        <button class="flex items-center gap-2 px-5 py-2.5 bg-primary text-white rounded-xl hover:bg-primary-dark transition-all font-bold text-sm shadow-lg shadow-primary/25">
            <span class="material-symbols-outlined text-lg">edit_square</span>
            <span>Update Status</span>
        </button>
    </div>
</div>
<!-- END: HeaderSection -->

<div class="max-w-7xl mx-auto custom-scrollbar">
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
        <!-- BEGIN: LeftColumn -->
        <div class="xl:col-span-2 space-y-8">
            <!-- General Info -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-50 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">info</span>
                        <h3 class="font-bold text-slate-800">General Information</h3>
                    </div>
                    <span class="text-[10px] bg-slate-100 text-slate-500 px-2.5 py-1 rounded-lg font-bold uppercase tracking-wider">Internal Reference</span>
                </div>
                <div class="p-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="flex flex-col gap-1">
                        <p class="text-[11px] text-slate-400 uppercase font-black tracking-widest">Customer</p>
                        <p class="text-sm font-bold text-slate-900">@Model.Order.UserName</p>
                        <p class="text-xs text-slate-500 flex items-center gap-1.5 mt-1">
                            <span class="material-symbols-outlined text-xs">mail</span>
                            @Model.Order.UserEmail
                        </p>
                    </div>
                    <div class="flex flex-col gap-1">
                        <p class="text-[11px] text-slate-400 uppercase font-black tracking-widest">Date Placed</p>
                        <p class="text-sm font-bold text-slate-900">@Model.Order.CreatedAt.ToString("MMMM dd, yyyy")</p>
                        <p class="text-xs text-slate-500 flex items-center gap-1.5 mt-1">
                            <span class="material-symbols-outlined text-xs">schedule</span>
                            @Model.Order.CreatedAt.ToString("hh:mm tt")
                        </p>
                    </div>
                    <div class="flex flex-col gap-1">
                        <p class="text-[11px] text-slate-400 uppercase font-black tracking-widest">Source Store(s)</p>
                        <p class="text-sm font-bold text-primary">@Model.Order.SubOrders.Count Store(s)</p>
                        <div class="flex -space-x-2 mt-1.5 overflow-hidden">
                            @foreach(var store in Model.Order.SubOrders.Select(s => s.StoreName).Distinct())
                            {
                                <div class="size-6 rounded-full bg-slate-200 border-2 border-white flex items-center justify-center text-[8px] font-bold text-slate-600" title="@store">
                                    @store.Substring(0, 1)
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sub Orders (One per Store) -->
            @foreach (var subOrder in Model.Order.SubOrders)
            {
                <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden mb-6">
                    <div class="p-6 border-b border-slate-50 flex items-center justify-between flex-wrap gap-4 bg-slate-50/30">
                        <div class="flex items-center gap-3">
                            <div class="size-10 rounded-xl bg-white border border-slate-100 flex items-center justify-center text-primary shadow-sm">
                                <span class="material-symbols-outlined">storefront</span>
                            </div>
                            <div>
                                <h3 class="font-bold text-slate-800">@subOrder.StoreName</h3>
                                <p class="text-[10px] text-slate-400 uppercase font-black tracking-widest">Store Shipment</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <div class="text-right hidden sm:block">
                                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest leading-none mb-1">Sub-Order ID</p>
                                <p class="text-xs font-mono font-bold text-slate-600">#@subOrder.Id.ToString().Substring(0, 8).ToUpper()</p>
                            </div>
                            <span class="px-3 py-1.5 rounded-xl text-xs font-black tracking-wider shadow-sm @(subOrder.Status == OrderStatus.Delivered ? "bg-green-100 text-green-700" : subOrder.Status == OrderStatus.Cancelled ? "bg-red-100 text-red-700" : "bg-blue-100 text-blue-700")">
                                @subOrder.Status.ToString().ToUpper()
                            </span>
                        </div>
                    </div>
                    
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50/20 border-b border-slate-50">
                                    <th class="px-6 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest">Product Details</th>
                                    <th class="px-6 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest text-right">Unit Price</th>
                                    <th class="px-6 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest text-center">Qty</th>
                                    <th class="px-6 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                @foreach (var item in subOrder.Items)
                                {
                                    <tr class="hover:bg-slate-50/50 transition-colors">
                                        <td class="px-6 py-5">
                                            <div class="flex items-center gap-4">
                                                <div class="relative flex-shrink-0 group/img">
                                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                                    {
                                                        <img alt="Thumbnail" class="size-14 rounded-xl object-cover bg-slate-100 border border-slate-100 shadow-sm transition-transform group-hover/img:scale-105" src="@item.ProductImage" />
                                                    }
                                                    else
                                                    {
                                                        <div class="size-14 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center shadow-sm">
                                                            <span class="material-symbols-outlined text-slate-200">image</span>
                                                        </div>
                                                    }
                                                </div>
                                                <div>
                                                    <p class="text-sm font-bold text-slate-900 leading-tight mb-1">@item.ProductName</p>
                                                    <div class="inline-flex py-0.5 px-2 rounded-lg bg-slate-100 text-[10px] font-bold text-slate-500 uppercase tracking-wider">@item.VariantName</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-5 text-right text-sm font-medium text-slate-600">@item.UnitPrice.ToString("N0") ₫</td>
                                        <td class="px-6 py-5 text-center text-sm font-black text-slate-900 bg-slate-50/30">@item.Quantity</td>
                                        <td class="px-6 py-5 text-right text-sm font-black text-slate-900">@item.LineTotal.ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Internal Financial Summary per Sub-Order (System Only) -->
                    <div class="px-6 py-8 bg-slate-50/20 border-t border-slate-50">
                        <div class="flex items-center gap-2 mb-4">
                            <span class="material-symbols-outlined text-xs text-slate-400">payments</span>
                            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Internal Transaction Analytics</span>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                             <div class="p-5 rounded-2xl bg-white border border-slate-100 shadow-sm flex flex-col gap-1">
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Subtotal (Gross)</p>
                                <p class="text-xl font-black text-slate-900">@subOrder.Subtotal.ToString("N0") <span class="text-xs font-medium italic">₫</span></p>
                            </div>
                            <div class="p-5 rounded-2xl bg-amber-50/30 border border-amber-100/50 shadow-sm flex flex-col gap-1">
                                <p class="text-[10px] font-bold text-amber-600 uppercase tracking-wider">Platform Fee (@((subOrder.CommissionRate * 100).ToString("N0"))%)</p>
                                <p class="text-xl font-black text-amber-700">- @subOrder.CommissionAmount.ToString("N0") <span class="text-xs font-medium italic">₫</span></p>
                            </div>
                            <div class="p-5 rounded-2xl bg-emerald-50/30 border border-emerald-100/50 shadow-sm flex flex-col gap-1">
                                <p class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider">Store Net Payout</p>
                                <p class="text-xl font-black text-emerald-700">@subOrder.NetAmount.ToString("N0") <span class="text-xs font-medium italic">₫</span></p>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Order Financial Grand Total -->
            <div class="bg-slate-900 rounded-3xl shadow-2xl overflow-hidden relative group">
                <!-- Decorative Glow -->
                <div class="absolute top-0 right-0 w-64 h-full bg-primary/10 blur-3xl -mr-32 group-hover:bg-primary/20 transition-all"></div>
                
                <div class="p-8 relative flex flex-col md:flex-row items-center justify-between gap-8">
                    <div class="flex items-center gap-4">
                        <div class="size-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-white shadow-inner">
                            <span class="material-symbols-outlined text-2xl">receipt_long</span>
                        </div>
                        <div>
                            <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Total Payable Amount</p>
                            <h3 class="text-white font-black text-lg tracking-tight">Consolidated Order Invoice</h3>
                        </div>
                    </div>

                    <div class="flex flex-col items-end gap-3 min-w-[240px]">
                        <div class="flex justify-between items-center w-full text-slate-400 text-xs font-bold uppercase tracking-widest border-b border-white/5 pb-2">
                            <span>Sum of Items</span>
                            <span class="text-slate-300">@(Model.Order.SubOrders.Sum(s => s.Subtotal).ToString("N0")) ₫</span>
                        </div>
                         <div class="flex justify-between items-center w-full text-slate-400 text-xs font-bold uppercase tracking-widest border-b border-white/5 pb-2">
                            <span>Logistics Fee</span>
                            <span class="text-slate-300">+ @Model.Order.ShippingFee.ToString("N0") ₫</span>
                        </div>
                        <div class="flex justify-between items-center w-full mt-2">
                            <span class="text-white text-base font-black uppercase tracking-tighter">Grand Total</span>
                            <span class="text-3xl font-black text-white tracking-tighter drop-shadow-lg">@Model.Order.GrandTotal.ToString("N0") <span class="text-sm font-medium">₫</span></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order History Timeline -->
            <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
                <div class="p-8 border-b border-slate-50 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="size-10 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-lg">
                            <span class="material-symbols-outlined text-lg">history</span>
                        </div>
                        <h3 class="font-bold text-slate-900 text-lg">Order Tracking Activity</h3>
                    </div>
                    <span class="px-3 py-1 bg-slate-100 text-slate-500 rounded-lg text-[10px] font-black uppercase tracking-widest">Real-time History</span>
                </div>
                <div class="p-8">
                    @if (Model.Order.StatusHistories.Any())
                    {
                        var statusIcons = new Dictionary<OrderStatus, string>
                        {
                            { OrderStatus.Pending, "pending" },
                            { OrderStatus.AwaitingPayment, "payments" },
                            { OrderStatus.Approved, "verified" },
                            { OrderStatus.Rejected, "block" },
                            { OrderStatus.Paid, "paid" },
                            { OrderStatus.Processing, "package_2" },
                            { OrderStatus.Delivered, "local_shipping" },
                            { OrderStatus.Cancelled, "do_not_disturb_on" },
                            { OrderStatus.Completed, "task_alt" },
                            { OrderStatus.Refunded, "keyboard_return" }
                        };

                        <div class="space-y-10 relative before:absolute before:inset-0 before:ml-[19px] before:h-full before:w-1 before:bg-gradient-to-b before:from-primary before:via-blue-300 before:to-transparent">
                            @foreach (var history in Model.Order.StatusHistories.OrderByDescending(h => h.ChangedAt))
                            {
                                var icon = statusIcons.ContainsKey(history.NewStatus) ? statusIcons[history.NewStatus] : "check_circle";
                                
                                <div class="relative flex items-start gap-8 group">
                                    <div class="z-10 bg-white p-1 rounded-full border-4 border-slate-50 group-first:border-primary/20 transition-all">
                                        <div class="size-7 rounded-full bg-white border-2 border-primary flex items-center justify-center shadow-sm">
                                            <span class="material-symbols-outlined text-primary text-[14px] font-black">@icon</span>
                                        </div>
                                    </div>
                                    <div class="flex-1 -mt-1 p-5 rounded-2xl bg-slate-50/50 border border-slate-100 hover:bg-white transition-all hover:shadow-md hover:border-primary/20">
                                        <div class="flex items-center justify-between mb-2">
                                            <h4 class="text-sm font-black text-slate-900 uppercase tracking-wider">@history.NewStatus.ToString()</h4>
                                            <span class="text-[10px] font-bold text-slate-400 flex items-center gap-1.5">
                                                <span class="material-symbols-outlined text-[10px]">calendar_month</span>
                                                @history.ChangedAt.ToString("MMM dd, yyyy - hh:mm tt")
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(history.Note))
                                        {
                                            <div class="relative">
                                                <span class="absolute left-0 top-0 text-slate-200 text-2xl leading-none">"</span>
                                                <p class="text-sm text-slate-500 italic px-4">@history.Note</p>
                                            </div>
                                        }
                                        <div class="mt-3 pt-3 border-t border-slate-100/50 flex items-center gap-2">
                                            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">Modified From</span>
                                            <span class="text-[10px] font-black text-slate-500 px-2 py-0.5 rounded bg-slate-100">@history.OldStatus</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center py-12 text-slate-400 gap-3 border-2 border-dashed border-slate-100 rounded-3xl">
                            <span class="material-symbols-outlined text-4xl opacity-20">history_toggle_off</span>
                            <p class="text-sm font-bold uppercase tracking-widest opacity-40">No activity recorded yet</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        <!-- END: LeftColumn -->
        <!-- BEGIN: RightColumn -->
        <div class="space-y-8">
            <!-- Delivery Info -->
            <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-50 flex items-center gap-3">
                    <div class="size-8 rounded-lg bg-blue-50 text-primary flex items-center justify-center">
                         <span class="material-symbols-outlined text-lg">local_shipping</span>
                    </div>
                    <h3 class="font-bold text-slate-800">Logistic Details</h3>
                </div>
                <div class="p-6 space-y-8">
                    <div>
                        <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-3">Recipient</p>
                        <div class="flex items-center gap-3">
                            <div class="size-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 font-bold">
                                @Model.Order.ReceiverName.Substring(0, 1)
                            </div>
                            <div>
                                <p class="text-sm font-black text-slate-900 leading-none">@Model.Order.ReceiverName</p>
                                <p class="text-xs text-slate-500 mt-1">@Model.Order.ReceiverPhone</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-3">Destination Address</p>
                        <div class="bg-slate-50 border border-slate-100 rounded-2xl p-5 text-sm font-medium text-slate-700 leading-relaxed shadow-inner">
                            @Html.Raw(Model.Order.ShippingAddress.Replace(",", ",<br/>"))
                        </div>
                    </div>
                    <div class="space-y-4 pt-2">
                        <div class="flex items-center justify-between">
                            <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest">Shipping Agent</p>
                            <span class="text-xs font-bold text-slate-900">@(Model.Order.ShippingProvider ?? "PENDING ASSIGNMENT")</span>
                        </div>
                        <div>
                             <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-2 text-right">Waybill / Tracking</p>
                             @if (!string.IsNullOrEmpty(Model.Order.TrackingNumber))
                             {
                                <div class="flex items-center justify-end gap-2">
                                    <code class="text-[11px] font-mono font-bold text-primary bg-primary/5 px-3 py-1.5 rounded-lg border border-primary/10">@Model.Order.TrackingNumber</code>
                                    <button class="size-8 flex items-center justify-center rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-primary hover:border-primary transition-all shadow-sm" onclick="navigator.clipboard.writeText('@Model.Order.TrackingNumber')">
                                        <span class="material-symbols-outlined text-[16px]">content_copy</span>
                                    </button>
                                </div>
                             }
                             else
                             {
                                 <p class="text-xs text-slate-400 italic text-right">No tracking info yet.</p>
                             }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Info -->
            <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-50 flex items-center gap-3">
                    <div class="size-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                         <span class="material-symbols-outlined text-lg">account_balance_wallet</span>
                    </div>
                    <h3 class="font-bold text-slate-800">Financial Clearance</h3>
                </div>
                <div class="p-6">
                    @if (Model.Order.Payments.Any())
                    {
                        var latestPayment = Model.Order.Payments.OrderByDescending(p => p.CreatedAt).First();
                        <div class="space-y-4">
                             <div class="flex justify-between items-center py-3 border-b border-slate-50">
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Gateway</span>
                                <span class="text-sm font-black text-slate-900 flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-sm text-primary">contactless</span>
                                    @latestPayment.Method
                                </span>
                            </div>
                            <div class="flex justify-between items-center py-3 border-b border-slate-50">
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Aggregator</span>
                                <span class="text-sm font-black text-slate-900">@latestPayment.Provider</span>
                            </div>
                            <div class="flex justify-between items-center py-3 border-b border-slate-50">
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Status</span>
                                <span class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider @(latestPayment.Status == "PAID" ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700")">@latestPayment.Status</span>
                            </div>
                             <div class="flex justify-between items-center py-3 border-b border-slate-50">
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Voucher Ref</span>
                                <span class="text-[11px] font-mono font-bold text-slate-500 bg-slate-50 px-2 py-1 rounded">@(latestPayment.TransactionRef ?? "PLATFORM_CREDIT")</span>
                            </div>
                            @if (latestPayment.PaidAt.HasValue)
                            {
                                <div class="flex justify-between items-center py-3">
                                    <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Clearance Date</span>
                                    <div class="text-right">
                                        <p class="text-sm font-black text-slate-900 leading-none">@latestPayment.PaidAt.Value.ToString("MMM dd, yyyy")</p>
                                        <p class="text-[10px] text-slate-400 font-bold mt-1">@latestPayment.PaidAt.Value.ToString("hh:mm tt")</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center py-6 text-slate-400 gap-2">
                             <span class="material-symbols-outlined text-3xl opacity-20">payments</span>
                             <p class="text-xs font-bold uppercase tracking-widest opacity-40">Awaiting Settlement</p>
