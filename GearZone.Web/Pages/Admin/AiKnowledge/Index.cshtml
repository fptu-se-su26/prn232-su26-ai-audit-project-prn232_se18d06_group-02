@page "/admin/ai-knowledge"
@using GearZone.Domain.Enums
@model GearZone.Web.Pages.Admin.AiKnowledge.IndexModel
@{
    ViewData["Title"] = "AI Knowledge";
    ViewData["PageHeader"] = "AI Knowledge";
    ViewData["ActivePage"] = "AiKnowledge";
    ViewData["Breadcrumb"] = new[] { "Dashboard", "AI Knowledge" };
    Layout = "_AdminLayout";

    var articles = Model.Data.Articles;
    var draftCount = Model.Data.StatusCounts.GetValueOrDefault(nameof(AiKnowledgeStatus.Draft));
    var publishedCount = Model.Data.StatusCounts.GetValueOrDefault(nameof(AiKnowledgeStatus.Published));
    var archivedCount = Model.Data.StatusCounts.GetValueOrDefault(nameof(AiKnowledgeStatus.Archived));
}

<div class="grid grid-cols-1 2xl:grid-cols-[minmax(0,1.4fr)_minmax(420px,.8fr)] gap-6 pb-12">
    <section class="min-w-0 space-y-5">
        <div class="bg-white border border-border-light rounded-xl shadow-card p-5">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div>
                    <h2 class="text-lg font-bold text-text-heading">Grounded answers for customers</h2>
                    <p class="mt-1 text-sm text-slate-500">Only published articles can be used by GearZone AI.</p>
                </div>
                <a asp-page="/Admin/AiKnowledge/Index"
                   class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-dark transition-colors">
                    <span class="material-symbols-outlined text-[19px]">add</span>
                    New article
                </a>
            </div>

            <div class="grid grid-cols-3 gap-3 mt-5">
                <div class="rounded-lg bg-slate-50 border border-slate-100 px-4 py-3">
                    <span class="text-xs font-semibold text-slate-500">Draft</span>
                    <strong class="block mt-1 text-xl text-slate-900">@draftCount</strong>
                </div>
                <div class="rounded-lg bg-emerald-50 border border-emerald-100 px-4 py-3">
                    <span class="text-xs font-semibold text-emerald-700">Published</span>
                    <strong class="block mt-1 text-xl text-emerald-900">@publishedCount</strong>
                </div>
                <div class="rounded-lg bg-slate-50 border border-slate-100 px-4 py-3">
                    <span class="text-xs font-semibold text-slate-500">Archived</span>
                    <strong class="block mt-1 text-xl text-slate-900">@archivedCount</strong>
                </div>
            </div>
        </div>

        <form method="get" class="bg-white border border-border-light rounded-xl shadow-card p-4">
            <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_170px_150px_auto] gap-3">
                <label class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-[20px] text-slate-400">search</span>
                    <input asp-for="Query.Search"
                           class="w-full h-10 rounded-lg border-slate-200 bg-slate-50 pl-10 text-sm focus:border-primary focus:ring-primary"
                           placeholder="Search title, slug or keywords" />
                </label>
                <select asp-for="Query.Category"
                        asp-items="Html.GetEnumSelectList<AiKnowledgeCategory>()"
                        class="h-10 rounded-lg border-slate-200 bg-slate-50 text-sm focus:border-primary focus:ring-primary">
                    <option value="">All categories</option>
                </select>
                <select asp-for="Query.Status"
                        asp-items="Html.GetEnumSelectList<AiKnowledgeStatus>()"
                        class="h-10 rounded-lg border-slate-200 bg-slate-50 text-sm focus:border-primary focus:ring-primary">
                    <option value="">All statuses</option>
                </select>
                <button type="submit"
                        class="h-10 rounded-lg border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                    Filter
                </button>
            </div>
        </form>

        <div class="overflow-hidden bg-white border border-border-light rounded-xl shadow-card">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[720px]">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr class="text-left text-[11px] font-bold uppercase tracking-wider text-slate-500">
                            <th class="px-5 py-3">Article</th>
                            <th class="px-4 py-3">Category</th>
                            <th class="px-4 py-3">Status</th>
                            <th class="px-4 py-3">Updated</th>
                            <th class="px-5 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (articles.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="px-5 py-16 text-center">
                                    <span class="material-symbols-outlined text-4xl text-slate-300">library_books</span>
                                    <p class="mt-2 text-sm font-semibold text-slate-700">No knowledge articles found</p>
                                    <p class="mt-1 text-xs text-slate-500">Create a draft to start grounding customer answers.</p>
                                </td>
                            </tr>
                        }
                        @foreach (var article in articles.Items)
                        {
                            <tr class="hover:bg-slate-50/70">
                                <td class="px-5 py-4">
                                    <a asp-page="/Admin/AiKnowledge/Index"
                                       asp-route-editId="@article.Id"
                                       class="block max-w-[340px]">
                                        <strong class="block truncate text-sm text-slate-800 hover:text-primary">@article.Title</strong>
                                        <span class="block truncate mt-1 text-xs text-slate-400">@article.Slug</span>
                                    </a>
                                </td>
                                <td class="px-4 py-4 text-sm text-slate-600">@article.Category</td>
                                <td class="px-4 py-4">
                                    @{
                                        var statusClass = article.Status switch
                                        {
                                            AiKnowledgeStatus.Published => "bg-emerald-50 text-emerald-700 border-emerald-200",
                                            AiKnowledgeStatus.Archived => "bg-slate-100 text-slate-600 border-slate-200",
                                            _ => "bg-amber-50 text-amber-700 border-amber-200"
                                        };
                                    }
                                    <span class="inline-flex rounded-full border px-2.5 py-1 text-[11px] font-bold @statusClass">
                                        @article.Status
                                    </span>
                                </td>
                                <td class="px-4 py-4 text-xs text-slate-500">
                                    @article.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                </td>
                                <td class="px-5 py-4">
                                    <div class="flex justify-end gap-2">
                                        <a asp-page="/Admin/AiKnowledge/Index"
                                           asp-route-editId="@article.Id"
                                           class="inline-flex size-8 items-center justify-center rounded-lg border border-slate-200 text-slate-600 hover:border-primary hover:text-primary"
                                           title="Edit">
                                            <span class="material-symbols-outlined text-[17px]">edit</span>
                                        </a>
                                        @if (article.Status != AiKnowledgeStatus.Published)
                                        {
                                            <form method="post" asp-page-handler="Publish" asp-route-id="@article.Id">
                                                <button type="submit"
                                                        class="inline-flex size-8 items-center justify-center rounded-lg border border-emerald-200 text-emerald-700 hover:bg-emerald-50"
                                                        title="Publish">
                                                    <span class="material-symbols-outlined text-[17px]">publish</span>
                                                </button>
                                            </form>
                                        }
                                        @if (article.Status != AiKnowledgeStatus.Archived)
                                        {
                                            <form method="post" asp-page-handler="Archive" asp-route-id="@article.Id">
                                                <button type="submit"
                                                        class="inline-flex size-8 items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-100"
                                                        title="Archive">
                                                    <span class="material-symbols-outlined text-[17px]">archive</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (articles.TotalPages > 1)
            {
                <div class="flex items-center justify-between border-t border-slate-200 px-5 py-3">
                    <span class="text-xs text-slate-500">
                        Page @articles.PageNumber of @articles.TotalPages
                    </span>
                    <div class="flex gap-2">
                        <a asp-page="/Admin/AiKnowledge/Index"
                           asp-route-Query.PageNumber="@(Math.Max(1, articles.PageNumber - 1))"
                           asp-route-Query.Search="@Model.Query.Search"
                           asp-route-Query.Category="@Model.Query.Category"
                           asp-route-Query.Status="@Model.Query.Status"
                           class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 @(articles.PageNumber <= 1 ? "pointer-events-none opacity-40" : "hover:bg-slate-50")">
                            Previous
                        </a>
                        <a asp-page="/Admin/AiKnowledge/Index"
                           asp-route-Query.PageNumber="@(Math.Min(articles.TotalPages, articles.PageNumber + 1))"
                           asp-route-Query.Search="@Model.Query.Search"
                           asp-route-Query.Category="@Model.Query.Category"
                           asp-route-Query.Status="@Model.Query.Status"
                           class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 @(articles.PageNumber >= articles.TotalPages ? "pointer-events-none opacity-40" : "hover:bg-slate-50")">
                            Next
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>

    <aside class="min-w-0">
        <form method="post"
              asp-page-handler="Save"
              asp-route-id="@Model.EditId"
              class="2xl:sticky 2xl:top-4 overflow-hidden bg-white border border-border-light rounded-xl shadow-card">
            <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
                <div>
                    <h2 class="text-base font-bold text-slate-900">
                        @(Model.EditId.HasValue ? "Edit article" : "New knowledge article")
                    </h2>
                    <p class="mt-1 text-xs text-slate-500">
                        @(Model.EditingArticle?.Status.ToString() ?? "Saved as Draft")
                    </p>
                </div>
                @if (Model.EditId.HasValue)
                {
                    <a asp-page="/Admin/AiKnowledge/Index"
                       class="inline-flex size-8 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100"
                       aria-label="Close editor">
                        <span class="material-symbols-outlined text-[19px]">close</span>
                    </a>
                }
            </div>

            <div class="space-y-4 p-5">
                <div asp-validation-summary="ModelOnly"
                     class="rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700"></div>

                <label class="block">
                    <span class="mb-1.5 block text-xs font-semibold text-slate-700">Title</span>
                    <input asp-for="Input.Title"
                           class="w-full rounded-lg border-slate-200 text-sm focus:border-primary focus:ring-primary"
                           placeholder="Example: Return policy for opened products" />
                    <span asp-validation-for="Input.Title" class="mt-1 block text-xs text-red-600"></span>
                </label>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <label class="block">
                        <span class="mb-1.5 block text-xs font-semibold text-slate-700">Slug</span>
                        <input asp-for="Input.Slug"
                               class="w-full rounded-lg border-slate-200 text-sm focus:border-primary focus:ring-primary"
                               placeholder="return-policy-opened-products" />
                        <span asp-validation-for="Input.Slug" class="mt-1 block text-xs text-red-600"></span>
                    </label>
                    <label class="block">
                        <span class="mb-1.5 block text-xs font-semibold text-slate-700">Category</span>
                        <select asp-for="Input.Category"
                                asp-items="Html.GetEnumSelectList<AiKnowledgeCategory>()"
                                class="w-full rounded-lg border-slate-200 text-sm focus:border-primary focus:ring-primary"></select>
                    </label>
                </div>

                <label class="block">
                    <span class="mb-1.5 block text-xs font-semibold text-slate-700">Keywords</span>
                    <input asp-for="Input.Keywords"
                           class="w-full rounded-lg border-slate-200 text-sm focus:border-primary focus:ring-primary"
                           placeholder="return, opened box, refund, exchange" />
                    <span class="mt-1 block text-[11px] text-slate-400">Separate search terms with commas.</span>
                    <span asp-validation-for="Input.Keywords" class="mt-1 block text-xs text-red-600"></span>
                </label>

                <label class="block">
                    <span class="mb-1.5 block text-xs font-semibold text-slate-700">Answer content</span>
                    <textarea asp-for="Input.Content"
                              rows="14"
                              class="w-full resize-y rounded-lg border-slate-200 text-sm leading-relaxed focus:border-primary focus:ring-primary"
                              placeholder="Write the approved customer-facing answer. Include conditions, exclusions and the correct next step."></textarea>
                    <span asp-validation-for="Input.Content" class="mt-1 block text-xs text-red-600"></span>
                </label>
            </div>

            <div class="flex items-center justify-between gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4">
                <span class="text-[11px] text-slate-500">Publishing is a separate reviewed action.</span>
                <button type="submit"
                        class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-dark">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    Save draft
                </button>
            </div>
        </form>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
